{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    <div class="mb-5">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_label %}
    {% if label is not same as(false) %}
        {% if label is empty %}
            {% set label = name|humanize %}
        {% endif %}
        <label for="{{ id }}" class="block text-sm font-medium text-[#b9b0cc] mb-2">
            {{ label|trans(label_translation_parameters, translation_domain) }}
            {% if required %}<span class="text-[#ff8a80]">*</span>{% endif %}
        </label>
    {% endif %}
{% endblock %}

{% block form_widget_simple %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white placeholder-[#5d5573] focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block textarea_widget %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white placeholder-[#5d5573] focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block choice_widget_collapsed %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block checkbox_widget %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' w-4 h-4 rounded-sm bg-[#110d1b] border-[#2e2640] text-[#f5a623] focus:ring-[#f5a623] focus:ring-offset-0')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block checkbox_row %}
    <div class="mb-5">
        <label class="flex items-center gap-2 cursor-pointer">
            {{ form_widget(form) }}
            <span class="text-sm text-[#b9b0cc]">{{ label|trans(label_translation_parameters, translation_domain) }}</span>
        </label>
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <div class="mt-2 space-y-1">
            {% for error in errors %}
                <p class="text-sm text-[#ff8a80]">{{ error.message }}</p>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block button_widget %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-3 px-6 rounded-md transition')|trim}) %}
    {{ parent() }}
{% endblock %}
