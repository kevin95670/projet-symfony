{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    <div class="mb-5">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_label %}
    {% if label is not same as(false) %}
        {% if label is empty %}
            {% set label = name|humanize %}
        {% endif %}
        <label for="{{ id }}" class="block text-sm font-medium text-slate-300 mb-2">
            {{ label|trans(label_translation_parameters, translation_domain) }}
            {% if required %}<span class="text-red-400">*</span>{% endif %}
        </label>
    {% endif %}
{% endblock %}

{% block form_widget_simple %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-lg text-white placeholder-slate-600 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block textarea_widget %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-lg text-white placeholder-slate-600 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block choice_widget_collapsed %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-lg text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block checkbox_widget %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' w-4 h-4 rounded bg-slate-950 border-slate-700 text-cyan-500 focus:ring-cyan-500 focus:ring-offset-0')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block checkbox_row %}
    <div class="mb-5">
        <label class="flex items-center gap-2 cursor-pointer">
            {{ form_widget(form) }}
            <span class="text-sm text-slate-400">{{ label|trans(label_translation_parameters, translation_domain) }}</span>
        </label>
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <div class="mt-2 space-y-1">
            {% for error in errors %}
                <p class="text-sm text-red-400">{{ error.message }}</p>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block button_widget %}
    {% set attr = attr|merge({'class': (attr.class|default('') ~ ' bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 px-6 rounded-lg transition')|trim}) %}
    {{ parent() }}
{% endblock %}