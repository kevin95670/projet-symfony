{% extends 'base.html.twig' %}

{% block title %}Erreur serveur - Replay{% endblock %}

{% block body %}
    <div class="max-w-6xl mx-auto px-4 py-24 text-center">
        <p class="text-[#f5a623] font-bold tracking-widest text-sm">ERREUR 500</p>
        <h1 class="mt-4 text-4xl font-extrabold">Un problème est survenu</h1>
        <p class="mt-4 text-[#b9b0cc]">Le site rencontre une erreur. Réessaie dans quelques instants.</p>
        <a href="{{ path('app_home') }}" class="inline-block mt-8 bg-[#f5a623] text-[#111] font-bold px-6 py-3 rounded-md hover:opacity-90 transition">Retour à l'accueil</a>
    </div>
{% endblock %}