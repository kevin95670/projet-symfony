{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}

<div class="max-w-7xl mx-auto px-4 py-12">

    <div class="flex items-baseline justify-between mb-6">
        <h2 class="text-2xl font-bold text-white">Dernières annonces</h2>
        <a href="#" class="text-sm text-slate-400 hover:text-white transition">Voir tout →</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for vente in last_ventes %}
            <article class="group bg-slate-900 border border-slate-800 rounded-xl overflow-hidden hover:border-slate-700 transition">

                <div class="aspect-4/3 bg-slate-800 overflow-hidden">
                    {% if vente.image %}
                        <img src="{{ vente.image }}" alt="{{ vente.titre }}"
                             class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                    {% else %}
                        <div class="w-full h-full flex items-center justify-center text-slate-600 text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                            </svg>
                        </div>
                    {% endif %}
                </div>

                <div class="p-5">
                    <div class="flex items-start justify-between gap-3 mb-2">
                        <h3 class="font-semibold text-white leading-snug">{{ vente.titre }}</h3>
                        <span class="shrink-0 text-lg font-bold text-white">{{ vente.prix }} €</span>
                    </div>

                    <p class="text-sm text-slate-400 line-clamp-2 mb-4">{{ vente.description }}</p>

                    <div class="flex flex-wrap gap-2 mb-4">
                        <span class="px-2 py-0.5 text-xs rounded bg-slate-800 text-slate-300">{{ vente.plateforme }}</span>
                        <span class="px-2 py-0.5 text-xs rounded bg-slate-800 text-slate-300">{{ vente.etat.value }}</span>
                        {% if vente.pegi %}
                            <span class="px-2 py-0.5 text-xs rounded bg-slate-800 text-slate-300">PEGI {{ vente.pegi.value }}</span>
                        {% endif %}
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-slate-800">
                        <a href="{{ path('vue_vendeur', {'pseudo': vente.vendeur.pseudo}) }}" class="text-sm text-slate-400">{{ vente.vendeur.pseudo }}</a>
                        <a href="{{ path('app_jeu', {'slug': vente.slug, 'id': vente.id}) }}" class="text-sm font-medium text-cyan-400 hover:text-cyan-300 transition">Voir →</a>
                    </div>
                    {# Actions #}
                    <div class="flex flex-col sm:flex-row gap-3 mt-3">
                        <a href="#" class="flex-1 text-center bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 px-6 rounded-lg transition">
                            Ajouter au panier
                        </a>
                        <a href="{% if app.user %}{{ path('wishlist_add', {'id': vente.id}) }}{% else %}{{ path('app_login') }}{% endif %}" class="flex items-center justify-center gap-2 border border-slate-700 hover:border-slate-500 text-slate-300 hover:text-white font-medium py-3 px-6 rounded-lg transition">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                            </svg>
                            Wishlist
                        </a>
                    </div>
                </div>

            </article>
        {% endfor %}
    </div>

</div>
{% endblock %}
