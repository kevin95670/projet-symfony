                                    {{ categorie.nom }}
                                </a>
                            {% endfor %}
                        {% endif %}
                        <span class="px-2 py-0.5 text-xs rounded bg-slate-800 text-slate-300">{{ jeu.plateforme }}</span>
                        <span class="px-2 py-0.5 text-xs rounded bg-slate-800 text-slate-300">{{ jeu.etat.value }}</span>
                        {% if jeu.pegi %}
                            <span class="px-2 py-0.5 text-xs rounded bg-slate-800 text-slate-300">PEGI {{ jeu.pegi.value }}</span>
                        {% endif %}
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-slate-800">
                        <a href="{{ path('vue_vendeur', {'pseudo': jeu.vendeur.pseudo}) }}"
                        class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-cyan-300 transition underline decoration-slate-700 hover:decoration-cyan-400 underline-offset-2">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                            {{ jeu.vendeur.pseudo }}
                        </a>
                        <a href="{{ path('app_jeu', {'slug': jeu.slug, 'id': jeu.id}) }}" class="text-sm font-medium text-cyan-400 hover:text-cyan-300 transition">Voir →</a>
                    </div>
                    {# Actions #}
                    <div class="flex flex-col sm:flex-row gap-3 mt-3">
                        <a href="#" class="flex-1 text-center bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 px-6 rounded-lg transition">
                            Ajouter au panier
                        </a>
                        <a href="#" class="flex items-center justify-center gap-2 border border-slate-700 hover:border-slate-500 text-slate-300 hover:text-white font-medium py-3 px-6 rounded-lg transition">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                            </svg>
                            Wishlist
                        </a>
                    </div>
                </div>

            </article>
        {% endfor %}
    </div>

</div>
{% endblock %}
