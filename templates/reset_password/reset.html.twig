{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

        <div class="bg-slate-900 border border-slate-800 rounded-xl p-8">

            <h1 class="text-2xl font-bold text-white mb-1">Nouveau mot de passe</h1>
            <p class="text-sm text-slate-400 mb-8">
                Choisissez un mot de passe que vous n'utilisez pas ailleurs.
            </p>

            {{ form_start(resetForm) }}

                {{ form_row(resetForm.plainPassword, { label: 'Nouveau mot de passe' }) }}

                <button type="submit"
                        class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 rounded-lg transition">
                    Enregistrer
                </button>

            {{ form_end(resetForm) }}

        </div>

    </div>
</div>
{% endblock %}