{% extends 'base.html.twig' %}

{% block title %}Email envoyé{% endblock %}

{% block body %}
<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

        <div class="bg-slate-900 border border-slate-800 rounded-xl p-8 text-center">

            <div class="w-14 h-14 mx-auto mb-6 rounded-full bg-cyan-500/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-cyan-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
            </div>

            <h1 class="text-2xl font-bold text-white mb-4">Vérifiez votre boîte mail</h1>

            <p class="text-slate-400 leading-relaxed mb-6">
                Si un compte correspond à cette adresse, un email vient d'être envoyé avec un lien permettant de réinitialiser votre mot de passe.
            </p>

            <p class="text-sm text-slate-500 mb-8">
                Ce lien expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
            </p>

            <a href="{{ path('app_login') }}"
               class="inline-block w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 rounded-lg transition">
                Retour à la connexion
            </a>

        </div>

        <p class="text-center text-sm text-slate-400 mt-6">
            Rien reçu ? Pensez à vérifier vos spams, ou
            <a href="{{ path('app_forgot_password_request') }}" class="text-cyan-400 hover:text-cyan-300 font-medium transition">réessayez</a>.
        </p>

    </div>
</div>
{% endblock %}