{% extends 'base.html.twig' %}

{% block title %}Éditer mon profil{% endblock %}

{% block body %}
<div class="max-w-md mx-auto px-4 py-16">

    <h1 class="text-2xl font-bold text-white mb-8">Éditer mon profil</h1>

    <div class="bg-slate-900 border border-slate-800 rounded-xl p-8">
        {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

            <div>
                {{ form_label(form.prenom, null, {'label_attr': {'class': 'block text-sm text-slate-400 mb-2'}}) }}
                {{ form_widget(form.prenom, {'attr': {'class': 'w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500'}}) }}
                {{ form_errors(form.prenom) }}
            </div>

            <div>
                {{ form_label(form.nom, null, {'label_attr': {'class': 'block text-sm text-slate-400 mb-2'}}) }}
                {{ form_widget(form.nom, {'attr': {'class': 'w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500'}}) }}
                {{ form_errors(form.nom) }}
            </div>

            <div>
                {{ form_label(form.pseudo, null, {'label_attr': {'class': 'block text-sm text-slate-400 mb-2'}}) }}
                {{ form_widget(form.pseudo, {'attr': {'class': 'w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500'}}) }}
                {{ form_errors(form.pseudo) }}
            </div>

            <div>
                {{ form_label(form.telephone, null, {'label_attr': {'class': 'block text-sm text-slate-400 mb-2'}}) }}
                {{ form_widget(form.telephone, {'attr': {'class': 'w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500'}}) }}
                {{ form_errors(form.telephone) }}
            </div>

            <div>
                {{ form_label(form.date_naissance, null, {'label_attr': {'class': 'block text-sm text-slate-400 mb-2'}}) }}
                {{ form_widget(form.date_naissance, {'attr': {'class': 'w-full bg-slate-950 border border-slate-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500'}}) }}
                {{ form_errors(form.date_naissance) }}
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit" class="flex-1 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 rounded-lg transition">
                    Enregistrer
                </button>
                <a href="{{ path('app_profil') }}" class="flex-1 text-center border border-slate-700 hover:border-slate-500 text-slate-300 hover:text-white font-medium py-3 rounded-lg transition">
                    Annuler
                </a>
            </div>

        {{ form_end(form) }}
    </div>

</div>
{% endblock %}