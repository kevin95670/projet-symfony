{% extends 'base.html.twig' %}

{% block title %}Éditer mon profil{% endblock %}

{% block body %}
<div class="max-w-md mx-auto px-4 py-16">

    <h1 class="text-2xl font-bold text-white mb-8">Éditer mon profil</h1>

    <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-8">
        {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

            <div>
                {{ form_label(form.prenom, null, {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-2'}}) }}
                {{ form_widget(form.prenom, {'attr': {'class': 'w-full bg-[#110d1b] border border-[#2e2640] rounded-md px-4 py-2.5 text-white focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition'}}) }}
                {{ form_errors(form.prenom) }}
            </div>

            <div>
                {{ form_label(form.nom, null, {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-2'}}) }}
                {{ form_widget(form.nom, {'attr': {'class': 'w-full bg-[#110d1b] border border-[#2e2640] rounded-md px-4 py-2.5 text-white focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition'}}) }}
                {{ form_errors(form.nom) }}
            </div>

            <div>
                {{ form_label(form.pseudo, null, {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-2'}}) }}
                {{ form_widget(form.pseudo, {'attr': {'class': 'w-full bg-[#110d1b] border border-[#2e2640] rounded-md px-4 py-2.5 text-white focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition'}}) }}
                {{ form_errors(form.pseudo) }}
            </div>

            <div>
                {{ form_label(form.telephone, null, {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-2'}}) }}
                {{ form_widget(form.telephone, {'attr': {'class': 'w-full bg-[#110d1b] border border-[#2e2640] rounded-md px-4 py-2.5 text-white focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition'}}) }}
                {{ form_errors(form.telephone) }}
            </div>

            <div>
                {{ form_label(form.date_naissance, null, {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-2'}}) }}
                {{ form_widget(form.date_naissance, {'attr': {'class': 'w-full bg-[#110d1b] border border-[#2e2640] rounded-md px-4 py-2.5 text-white focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition'}}) }}
                {{ form_errors(form.date_naissance) }}
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit" class="flex-1 bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-3 rounded-md transition">
                    Enregistrer
                </button>
                <a href="{{ path('app_profil') }}" class="flex-1 text-center border border-[#2e2640] hover:border-[#f5a623] text-[#b9b0cc] hover:text-white font-medium text-sm py-3 rounded-md transition">
                    Annuler
                </a>
            </div>

        {{ form_end(form) }}
    </div>

</div>
{% endblock %}
