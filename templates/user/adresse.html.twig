{% extends 'base.html.twig' %}

{% block title %}Mon adresse de livraison{% endblock %}

{% block body %}
    <div class="max-w-xl mx-auto px-4 py-8">

        <h1 class="text-2xl font-bold text-white mb-2">Mon adresse de livraison</h1>
        <p class="text-sm text-[#b9b0cc] mb-6">
            Elle est proposée automatiquement sur la page de paiement. Livraison en France uniquement.
        </p>

        {# Messages (succès ou erreur) #}
        {% for message in app.flashes('success') %}
            <div class="mb-4 px-4 py-3 rounded-md bg-[#f5a623]/15 border border-[#f5a623]/40 text-sm text-white">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mb-4 px-4 py-3 rounded-md bg-[#ff8a80]/15 border border-[#ff8a80]/40 text-sm text-white">{{ message }}</div>
        {% endfor %}

        {% if erreurs|length > 0 %}
            <div class="mb-4 px-4 py-3 rounded-md bg-[#ff8a80]/15 border border-[#ff8a80]/40 text-sm text-white">
                <ul class="list-disc list-inside">
                    {% for erreur in erreurs %}
                        <li>{{ erreur }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form method="POST" action="{{ path('app_user_adresse') }}"
              class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-6 space-y-4">

            <input type="hidden" name="_token" value="{{ csrf_token('adresse') }}">

            <div>
                <label class="block text-xs text-[#8a82a0] mb-1">Nom complet du destinataire</label>
                <input type="text" name="nom" value="{{ valeurs.nom|default('') }}" required maxlength="120"
                       class="w-full bg-[#110d1b] border border-[#2e2640] text-sm text-white rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]">
            </div>

            <div>
                <label class="block text-xs text-[#8a82a0] mb-1">Adresse</label>
                <input type="text" name="ligne1" value="{{ valeurs.ligne1|default('') }}" required maxlength="200"
                       class="w-full bg-[#110d1b] border border-[#2e2640] text-sm text-white rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]">
            </div>

            <div>
                <label class="block text-xs text-[#8a82a0] mb-1">Complément (facultatif)</label>
                <input type="text" name="ligne2" value="{{ valeurs.ligne2|default('') }}" maxlength="200"
                       class="w-full bg-[#110d1b] border border-[#2e2640] text-sm text-white rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs text-[#8a82a0] mb-1">Code postal</label>
                    <input type="text" name="code_postal" value="{{ valeurs.code_postal|default('') }}" required pattern="\d{5}" inputmode="numeric"
                           class="w-full bg-[#110d1b] border border-[#2e2640] text-sm text-white rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]">
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-xs text-[#8a82a0] mb-1">Ville</label>
                    <input type="text" name="ville" value="{{ valeurs.ville|default('') }}" required maxlength="120"
                           class="w-full bg-[#110d1b] border border-[#2e2640] text-sm text-white rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]">
                </div>
            </div>

            <div>
                <label class="block text-xs text-[#8a82a0] mb-1">Pays</label>
                <input type="text" value="France" disabled
                       class="w-full bg-[#110d1b] border border-[#2e2640] text-sm text-[#8a82a0] rounded-md px-3 py-2">
            </div>

            <button type="submit"
                    class="w-full bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-2 px-4 rounded-md transition">
                Enregistrer mon adresse
            </button>
        </form>

    </div>
{% endblock %}
