{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-4 py-12">

    {% for message in app.flashes('success') %}
        <div class="mb-6 rounded-md bg-[#9ae6b4]/10 border border-[#9ae6b4]/30 text-[#9ae6b4] px-4 py-3 text-sm">
            {{ message }}
        </div>
    {% endfor %}

    <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg overflow-hidden">

        {# Bandeau header #}
        <div class="bg-gradient-to-r from-[#f5a623]/15 via-[#4a1d2e]/20 to-transparent px-8 py-10 flex items-center gap-6 border-b border-[#2e2640]">

            <img class="w-20 h-20 rounded-full bg-[#2a2040] ring-2 ring-[#f5a623]/40 shrink-0"
                 src="https://api.dicebear.com/9.x/avataaars/svg?seed={{ app.user.pseudo }}"
                 alt="Avatar de {{ app.user.pseudo }}">

            <div>
                <h1 class="text-xl font-bold text-white">{{ app.user.pseudo }}</h1>
                <p class="text-sm text-[#b9b0cc] mt-1">{{ app.user.email }}</p>
            </div>

        </div>

        {# Infos du compte #}
        <div class="px-8 py-6">
            <h2 class="text-sm font-medium text-[#8a82a0] uppercase tracking-wider mb-4">Informations du compte</h2>

            <dl class="space-y-4">
                <div class="flex items-center justify-between py-3 border-b border-[#2e2640]">
                    <dt class="text-sm text-[#b9b0cc]">Pseudo</dt>
                    <dd class="text-sm text-white font-medium">{{ app.user.pseudo }}</dd>
                </div>

                <div class="flex items-center justify-between py-3 border-b border-[#2e2640]">
                    <dt class="text-sm text-[#b9b0cc]">Adresse email</dt>
                    <dd class="text-sm text-white font-medium">{{ app.user.email }}</dd>
                </div>

                <div class="flex items-center justify-between py-3">
                    <dt class="text-sm text-[#b9b0cc]">Rôle</dt>
                    <dd class="text-sm text-[#f5a623] font-medium">
                        {% if 'ROLE_ADMIN' in app.user.roles %}
                            Administrateur
                        {% else %}
                            Membre
                        {% endif %}
                    </dd>
                </div>
            </dl>

            <div class="flex flex-col sm:flex-row gap-3 mt-8">
                <a href="{{ path('app_user_edit') }}"
                   class="flex-1 text-center bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-3 px-6 rounded-md transition">
                    Éditer le profil
                </a>
            </div>
        </div>

    </div>

    {# Liens secondaires #}
    <div class="flex justify-center gap-6 mt-6 text-sm">
        <a href="{{ path('app_commandes') }}" class="text-[#b9b0cc] hover:text-[#f5a623] transition">Mes commandes</a>
        <a href="{{ path('app_wishlist') }}" class="text-[#b9b0cc] hover:text-[#f5a623] transition">Ma wishlist</a>
        <a href="{{ path('app_cart') }}" class="text-[#b9b0cc] hover:text-[#f5a623] transition">Mon panier</a>
    </div>

</div>
{% endblock %}
