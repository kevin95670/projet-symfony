{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-4 py-12">

    {% for message in app.flashes('success') %}
        <div class="mb-6 rounded-lg bg-green-50 border border-green-200 text-green-700 px-4 py-3 text-sm">
            {{ message }}
        </div>
    {% endfor %}

    <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">

        {# Bandeau header #}
        <div class="bg-gradient-to-r from-cyan-500/10 to-transparent px-8 py-10 flex items-center gap-6 border-b border-slate-800">

            <img class="w-20 h-20 rounded-full bg-slate-800 ring-2 ring-slate-700 shrink-0"
                 src="https://api.dicebear.com/9.x/avataaars/svg?seed={{ app.user.pseudo }}"
                 alt="Avatar de {{ app.user.pseudo }}">

            <div>
                <h1 class="text-xl font-bold text-white">{{ app.user.pseudo }}</h1>
                <p class="text-sm text-slate-400 mt-1">{{ app.user.email }}</p>
            </div>

        </div>

        {# Infos du compte #}
        <div class="px-8 py-6">
            <h2 class="text-sm font-medium text-slate-500 uppercase tracking-wider mb-4">Informations du compte</h2>

            <dl class="space-y-4">
                <div class="flex items-center justify-between py-3 border-b border-slate-800">
                    <dt class="text-sm text-slate-400">Pseudo</dt>
                    <dd class="text-sm text-white font-medium">{{ app.user.pseudo }}</dd>
                </div>

                <div class="flex items-center justify-between py-3 border-b border-slate-800">
                    <dt class="text-sm text-slate-400">Adresse email</dt>
                    <dd class="text-sm text-white font-medium">{{ app.user.email }}</dd>
                </div>

                <div class="flex items-center justify-between py-3">
                    <dt class="text-sm text-slate-400">Rôle</dt>
                    <dd class="text-sm text-white font-medium">
                        {% if 'ROLE_ADMIN' in app.user.roles %}
                            Administrateur
                        {% else %}
                            Membre
                        {% endif %}
                    </dd>
                </div>
            </dl>

            <div class="flex flex-col sm:flex-row gap-3 mt-8">
                <a href="{{ path('app_user_edit') }}"
                   class="flex-1 text-center bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 px-6 rounded-lg transition">
                    Éditer le profil
                </a>
            </div>
        </div>

    </div>

    {# Liens secondaires #}
    <div class="flex justify-center gap-6 mt-6 text-sm">
        <a href="{{ path('app_commandes') }}" class="text-slate-400 hover:text-cyan-300 transition">Mes commandes</a>
        <a href="{{ path('app_wishlist') }}" class="text-slate-400 hover:text-cyan-300 transition">Ma wishlist</a>
        <a href="{{ path('app_cart') }}" class="text-slate-400 hover:text-cyan-300 transition">Mon panier</a>
    </div>

</div>
{% endblock %}