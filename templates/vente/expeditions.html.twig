{% extends 'base.html.twig' %}

{% block title %}Commandes à expédier{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- En-tête -->
    <div class="mb-8">
        <a href="{{ path('app_ventes', {'vendeurId': app.user.id}) }}" class="text-[#b9b0cc] hover:text-[#f5a623] text-sm transition">← Retour à mes ventes</a>
        <h1 class="text-3xl font-bold text-white mt-4">Commandes à expédier</h1>
        <p class="mt-2 text-[#b9b0cc]">Saisis le numéro de suivi quand tu expédies un jeu. La réception est confirmée par l'acheteur.</p>
    </div>

    {% for flash in app.flashes('success') %}
        <div class="bg-[#9ae6b4]/10 border border-[#9ae6b4]/30 text-[#9ae6b4] text-sm rounded-md px-4 py-3 mb-6">{{ flash }}</div>
    {% endfor %}
    {% for flash in app.flashes('error') %}
        <div class="bg-[#ff8a80]/10 border border-[#ff8a80]/30 text-[#ff8a80] text-sm rounded-md px-4 py-3 mb-6">{{ flash }}</div>
    {% endfor %}

    {% if lignes|length > 0 %}
        <div class="space-y-4">
            {% for ligne in lignes %}
                <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-6">
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-4 mb-4">
                        <div>
                            <h2 class="font-semibold text-white">{{ ligne.jeu.titre }}</h2>
                            <p class="text-sm text-[#b9b0cc] mt-1">
                                Acheteur : {{ ligne.commande.user.pseudo }} · Commande {{ ligne.commande.reference }} · {{ ligne.commande.dateCommande|date('d/m/Y') }}
                            </p>
                            <p class="text-sm text-[#b9b0cc]">Quantité : {{ ligne.quantite }} · {{ ligne.prixUnitaire }} €</p>
                        </div>
                        <span class="self-start px-3 py-1 rounded-sm text-xs font-medium bg-[#110d1b] border border-[#2e2640] text-[#b9b0cc]">
                            {{ ligne.statut.label }}
                        </span>
                    </div>

                    {% set livraison = ligne.commande.livraison %}
                    {% if livraison %}
                        <div class="text-sm text-[#b9b0cc] mb-4 bg-[#110d1b] border border-[#2e2640] rounded-md p-3">
                            <p class="text-xs text-[#8a82a0] mb-1">Adresse de livraison</p>
                            <p class="text-white">{{ livraison.nom }}</p>
                            <p>{{ livraison.ligne1 }}{% if livraison.ligne2 %}, {{ livraison.ligne2 }}{% endif %}</p>
                            <p>{{ livraison.code_postal }} {{ livraison.ville }}</p>
                            <p>{{ livraison.pays }}</p>
                        </div>
                    {% endif %}

                    {% if ligne.numeroSuivi %}
                        <p class="text-sm text-[#b9b0cc] mb-4">N° de suivi : <span class="text-white">{{ ligne.numeroSuivi }}</span></p>
                    {% endif %}

                    {% if ligne.statut.value == 'en_preparation' %}
                        <form method="post" action="{{ path('app_vente_ligne_avancer', {'id': ligne.id}) }}" class="flex flex-col sm:flex-row gap-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('ligne-' ~ ligne.id) }}">
                            <input type="text" name="numero_suivi" maxlength="100"
                                   placeholder="Numéro de suivi (obligatoire)"
                                   class="flex-1 bg-[#110d1b] border border-[#2e2640] text-white text-sm rounded-md px-3 py-2 placeholder-[#5d5573] focus:outline-none focus:border-[#f5a623]">
                            <button type="submit" class="bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-2 px-5 rounded-md transition">
                                Marquer comme expédié
                            </button>
                        </form>
                    {% elseif ligne.statut.value == 'expediee' %}
                        <p class="text-sm text-[#8a82a0]">En attente de la confirmation de réception par l'acheteur.</p>
                    {% else %}
                        <p class="text-sm text-[#9ae6b4]">Reçu par l'acheteur.</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-8 text-center text-[#b9b0cc]">
            Aucune commande pour le moment.
        </div>
    {% endif %}

</div>
{% endblock %}
