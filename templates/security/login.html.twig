{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">

    <div class="w-full max-w-md">

        <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-8">

            <h1 class="text-2xl font-bold text-white mb-1">Connexion</h1>
            <p class="text-sm text-[#b9b0cc] mb-8">Retrouvez vos annonces et votre panier.</p>

            {% if error %}
                <div class="mb-6 px-4 py-3 rounded-md bg-[#ff8a80]/10 border border-[#ff8a80]/30 text-[#ff8a80] text-sm">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mb-6 px-4 py-3 rounded-md bg-[#110d1b] border border-[#2e2640] text-[#b9b0cc] text-sm">
                    Connecté en tant que <span class="text-white font-medium">{{ app.user.userIdentifier }}</span>.
                    <a href="{{ logout_path() }}" class="text-[#f5a623] hover:text-white transition">Se déconnecter</a>
                </div>
            {% endif %}

            <form method="post" class="space-y-5">

                <div>
                    <label for="username" class="block text-sm font-medium text-[#b9b0cc] mb-2">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username"
                           autocomplete="email" required autofocus placeholder="test@test.com"
                           class="w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white placeholder-[#5d5573] focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition">
                </div>

                <div>
                    <div class="flex items-baseline justify-between mb-2">
                        <label for="password" class="block text-sm font-medium text-[#b9b0cc]">Mot de passe</label>
                        <a href="{{ path('app_forgot_password_request') }}" class="text-xs text-[#8a82a0] hover:text-[#f5a623] transition">Mot de passe oublié ?</a>
                    </div>
                    <input type="password" name="_password" id="password"
                           autocomplete="current-password" required
                           class="w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition">
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="_remember_me" id="_remember_me"
                           class="w-4 h-4 rounded-sm bg-[#110d1b] border-[#2e2640] text-[#f5a623] focus:ring-[#f5a623] focus:ring-offset-0">
                    <span class="text-sm text-[#b9b0cc]">Se souvenir de moi</span>
                </label>

                <button type="submit"
                        class="w-full bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-3 rounded-md transition">
                    Se connecter
                </button>

            </form>

        </div>

        <p class="text-center text-sm text-[#b9b0cc] mt-6">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="text-[#f5a623] hover:text-white font-medium transition">Créer un compte</a>
        </p>

    </div>
</div>
{% endblock %}
