{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">

    <div class="w-full max-w-md">

        <div class="bg-slate-900 border border-slate-800 rounded-xl p-8">

            <h1 class="text-2xl font-bold text-white mb-1">Connexion</h1>
            <p class="text-sm text-slate-400 mb-8">Retrouvez vos annonces et votre panier.</p>

            {% if error %}
                <div class="mb-6 px-4 py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mb-6 px-4 py-3 rounded-lg bg-slate-800 text-slate-300 text-sm">
                    Connecté en tant que <span class="text-white font-medium">{{ app.user.userIdentifier }}</span>.
                    <a href="{{ logout_path() }}" class="text-cyan-400 hover:text-cyan-300 transition">Se déconnecter</a>
                </div>
            {% endif %}

            <form method="post" class="space-y-5">

                <div>
                    <label for="username" class="block text-sm font-medium text-slate-300 mb-2">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username"
                           autocomplete="email" required autofocus placeholder="test@test.com"
                           class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-lg text-white placeholder-slate-600 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition">
                </div>

                <div>
                    <div class="flex items-baseline justify-between mb-2">
                        <label for="password" class="block text-sm font-medium text-slate-300">Mot de passe</label>
                        <a href="{{ path('app_recover_password') }}" class="text-xs text-slate-500 hover:text-slate-300 transition">Mot de passe oublié ?</a>
                    </div>
                    <input type="password" name="_password" id="password"
                           autocomplete="current-password" required
                           class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-lg text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition">
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="_remember_me" id="_remember_me"
                           class="w-4 h-4 rounded bg-slate-950 border-slate-700 text-cyan-500 focus:ring-cyan-500 focus:ring-offset-0">
                    <span class="text-sm text-slate-400">Se souvenir de moi</span>
                </label>

                <button type="submit"
                        class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 rounded-lg transition">
                    Se connecter
                </button>

            </form>

        </div>

        <p class="text-center text-sm text-slate-400 mt-6">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="text-cyan-400 hover:text-cyan-300 font-medium transition">Créer un compte</a>
        </p>

    </div>
</div>
{% endblock %}