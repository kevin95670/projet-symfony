{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-4 py-12">

    <h1 class="text-2xl font-bold text-white mb-8">Mes commandes</h1>

    {% for message in app.flashes('success') %}
        <div class="mb-6 rounded-md bg-[#9ae6b4]/10 border border-[#9ae6b4]/30 text-[#9ae6b4] px-4 py-3 text-sm">
            {{ message }}
        </div>
    {% endfor %}

    {% if commandes is empty %}
        <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-10 text-center">
            <p class="text-[#b9b0cc] text-lg mb-4">Vous n'avez pas encore passé de commande.</p>
            <a href="{{ path('app_home') }}" class="inline-block bg-[#f5a623] hover:bg-[#ffb84d] text-[#111] font-bold text-sm px-6 py-2.5 rounded-md transition">
                Parcourir les annonces
            </a>
        </div>
    {% else %}
        <div class="space-y-4">
            {% for commande in commandes %}
                {% set total = 0 %}
                {% for ligne in commande.commandeLignes %}
                    {% set total = total + (ligne.prixUnitaire * ligne.quantite) %}
                {% endfor %}

                <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 hover:border-[#f5a623]/60 transition">

                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-md bg-[#f5a623]/10 border border-[#f5a623]/40 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-[#f5a623]">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 14.25l6-6m4.5-3.493V21.75l-3.75-1.5-3.75 1.5-3.75-1.5-3.75 1.5V4.757c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0c1.1.128 1.907 1.077 1.907 2.185z" />
                            </svg>
                        </div>

                        <div>
                            <p class="font-semibold text-white">
                                Commande {% if commande.reference is defined and commande.reference %}#{{ commande.reference }}{% else %}#{{ commande.id }}{% endif %}
                            </p>
                            <p class="text-sm text-[#8a82a0] mt-0.5">
                                {% if commande.dateCommande is defined and commande.dateCommande %}
                                    {{ commande.dateCommande|date('d/m/Y à H:i') }}
                                {% endif %}
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-6">
                        <div class="text-right">
                            <p class="text-lg font-bold text-[#f5a623]">{{ total|number_format(2, ',', ' ') }} €</p>
                            <p class="text-xs text-[#8a82a0]">
                                {{ commande.commandeLignes|length }} article{{ commande.commandeLignes|length > 1 ? 's' : '' }}
                            </p>
                        </div>

                        <a href="{{ path('app_commande', {'id': commande.id}) }}"
                           class="whitespace-nowrap bg-white hover:bg-[#f5a623] text-[#111] text-sm font-bold px-5 py-2.5 rounded-md transition">
                            Voir le détail
                        </a>
                    </div>

                </div>
            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}
