{% extends 'base.html.twig' %}

{% block title %}Commande confirmée{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-4 py-16 text-center">

    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-500/10 border border-green-500 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8 text-green-400">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
    </div>

    <h1 class="text-2xl font-bold text-white mb-2">Commande confirmée !</h1>
    <p class="text-slate-400 mb-10">
        Un email de confirmation vient de vous être envoyé avec le récapitulatif de votre commande.
    </p>

    <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 text-left mb-8">
        <h2 class="font-semibold text-white mb-4">Récapitulatif</h2>

        <ul class="divide-y divide-slate-800">
            {% set total = 0 %}
            {% for item in commande.commandeLignes %}
                {% set sousTotal = item.prixUnitaire * item.quantite %}
                {% set total = total + sousTotal %}
                <li class="py-3 flex justify-between text-sm">
                    <span class="text-slate-300">{{ item.jeu.titre }} × {{ item.quantite }}</span>
                    <span class="text-slate-400">{{ sousTotal|number_format(2, ',', ' ') }} €</span>
                </li>
            {% endfor %}
        </ul>

        <div class="pt-4 mt-2 border-t border-slate-800 flex justify-between font-semibold text-white">
            <span>Total</span>
            <span>{{ total|number_format(2, ',', ' ') }} €</span>
        </div>
    </div>

    <a href="{{ path('app_home') }}" class="inline-block bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 px-8 rounded-lg transition">
        Retour à l'accueil
    </a>

</div>
{% endblock %}