{% extends 'base.html.twig' %}

{% block title %}Commande confirmée{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-4 py-16 text-center">

    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-[#9ae6b4]/10 border border-[#9ae6b4] mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8 text-[#9ae6b4]">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
    </div>

    <h1 class="text-2xl font-bold text-white mb-2">Commande confirmée !</h1>
    <p class="text-[#b9b0cc] mb-10">
        Un email de confirmation vient de vous être envoyé avec le récapitulatif de votre commande.
    </p>

    <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-6 text-left mb-8">
        <h2 class="font-semibold text-white mb-4">Récapitulatif</h2>

        <ul class="divide-y divide-[#2e2640]">
            {% set total = 0 %}
            {% for item in commande.commandeLignes %}
                {% set sousTotal = item.prixUnitaire * item.quantite %}
                {% set total = total + sousTotal %}
                <li class="py-3 flex justify-between text-sm">
                    <span class="text-white">{{ item.jeu.titre }} × {{ item.quantite }}</span>
                    <span class="text-[#f5a623] font-medium">{{ sousTotal|number_format(2, ',', ' ') }} €</span>
                </li>
            {% endfor %}
        </ul>

        <div class="pt-4 mt-2 border-t border-[#2e2640] flex justify-between font-bold text-white">
            <span>Total</span>
            <span class="text-[#f5a623]">{{ total|number_format(2, ',', ' ') }} €</span>
        </div>
    </div>

    <a href="{{ path('app_home') }}" class="inline-block bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-3 px-8 rounded-md transition">
        Retour à l'accueil
    </a>

</div>
{% endblock %}
