{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">

    <h1 class="text-2xl font-bold text-white mb-6">Notifications</h1>

    {% if notifications|length > 0 %}
        <ul class="bg-[#1c1628] border border-[#2e2640] rounded-lg divide-y divide-[#2e2640]">
            {% for notification in notifications %}
                <li class="px-6 py-4 flex items-start gap-4 {{ notification.lue ? '' : 'bg-[#f5a623]/5' }}">
                    {% if not notification.lue %}
                        <span class="mt-2 w-2 h-2 rounded-full bg-[#f5a623] shrink-0" title="Nouvelle"></span>
                    {% else %}
                        <span class="mt-2 w-2 h-2 shrink-0"></span>
                    {% endif %}

                    <div class="flex-1 min-w-0">
                        <p class="text-sm text-white">{{ notification.message }}</p>
                        <p class="text-xs text-[#8a82a0] mt-1">{{ notification.dateCreation|date('d/m/Y à H:i') }}</p>
                    </div>

                    {% if notification.lien %}
                        <a href="{{ notification.lien }}" class="text-sm text-[#f5a623] hover:underline shrink-0">Voir</a>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-8 text-center text-[#b9b0cc]">
            Aucune notification pour le moment.
        </div>
    {% endif %}

</div>
{% endblock %}
