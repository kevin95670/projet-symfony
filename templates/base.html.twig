<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Replay{% endblock %}</title>
        <meta name="description" content="Achète et vends tes jeux vidéo d'occasion entre particuliers sur Replay.">
        <meta name="robots" content="noindex, nofollow">

        {# Balises Open Graph : aperçu lors du partage sur les réseaux sociaux. Les pages peuvent les remplacer. #}
        {% block og %}
            <meta property="og:site_name" content="Replay">
            <meta property="og:type" content="website">
            <meta property="og:title" content="Replay — jeux vidéo d'occasion">
            <meta property="og:description" content="Achète et vends tes jeux vidéo d'occasion entre particuliers.">
            <meta property="og:url" content="{{ url('app_home') }}">
        {% endblock %}
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
        {% endblock %}

        {% block javascripts %}
            <script src="https://code.jquery.com/jquery-4.0.0.min.js" integrity="sha256-OaVG6prZf4v69dPg6PhVattBXkcOWQB62pdZ3ORyrao=" crossorigin="anonymous" defer></script>
            <script src="{{ asset('scripts/burger-menu.js') }}" defer></script>
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="bg-[#0d0a14] text-white font-sans antialiased">

        {% block header %}

        <header>
            <nav class="bg-[#110d1b] border-b border-[#2e2640] sticky top-0 z-20">
                <div class="max-w-7xl mx-auto px-4">
                    <div class="flex items-center gap-4 h-16">

                        {# Logo #}
                        <a href="{{ path('app_home') }}" class="text-xl font-extrabold tracking-wider text-white shrink-0">
                            RE<span class="text-[#f5a623]">PLAY</span>
                        </a>

                        {# Liens de navigation - cachés sur mobile #}
                        <div class="hidden md:flex items-center gap-6 ml-auto text-sm text-[#b9b0cc]">
                            <a href="{{ path('app_jeux_liste') }}" class="hover:text-[#f5a623] transition">Acheter un jeu</a>
                            <a href="{{ app.user ? path('app_jeu_vendre') : path('app_login') }}" class="hover:text-[#f5a623] transition">Vendre un jeu</a>
                            <a href="{{ app.user ? path('app_wishlist') : path('app_login') }}" class="hover:text-[#f5a623] transition">Liste de souhaits</a>
                        </div>

                        {# Icônes à droite #}
                        <div class="flex items-center gap-4 ml-auto md:ml-0">

                            {# Moteur de recherche - caché sur mobile #}
                            <form method="GET" action="{{ path('app_jeux_liste') }}" class="hidden sm:flex items-center">
                                <div class="relative">
                                    <svg class="w-4 h-4 text-[#8a82a0] absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
                                    </svg>
                                    <input
                                        type="text"
                                        name="q"
                                        value="{{ app.request.query.get('q') }}"
                                        placeholder="Rechercher un jeu..."
                                        class="bg-[#1c1628] border border-[#2e2640] text-sm text-white placeholder-[#8a82a0] rounded-md pl-9 pr-3 py-1.5 w-48 lg:w-56 focus:outline-none focus:border-[#f5a623] transition"
                                    >
                                </div>
                            </form>

                            {# Notifications #}
                            {% if app.user %}
                                <a href="{{ path('app_notifications') }}" class="relative text-[#b9b0cc] hover:text-[#f5a623] transition" title="Notifications">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 10-12 0v3.2a2 2 0 01-.6 1.4L4 17h5m6 0a3 3 0 11-6 0m6 0H9" />
                                    </svg>
                                    {% set nonLues = notifications_non_lues() %}
                                    {% if nonLues > 0 %}
                                        <span class="absolute -top-2 -right-2 bg-[#f5a623] text-[#111] text-xs font-bold rounded-full min-w-5 h-5 px-1 flex items-center justify-center">
                                            {{ nonLues }}
                                        </span>
                                    {% endif %}
                                </a>
                            {% endif %}

                            {# Panier - toujours visible #}
                            <a href="{{ path('app_cart') }}" class="relative text-[#b9b0cc] hover:text-[#f5a623] transition" title="Panier">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>

                                {% set count = panier_count() %}
                                {% if count > 0 %}
                                    <span class="absolute -top-2 -right-2 bg-[#f5a623] text-[#111] text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center">
                                        {{ count }}
                                    </span>
                                {% endif %}
                            </a>

                            {# Compte #}
                            {% if app.user %}
                                {# Menu ouvert au clic (fonctionne sur téléphone comme sur ordinateur) #}
                                <details class="relative">
                                    <summary class="list-none cursor-pointer text-[#b9b0cc] hover:text-[#f5a623] transition [&::-webkit-details-marker]:hidden" title="Mon compte">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                        </svg>
                                    </summary>

                                    <div class="absolute z-30 right-0 top-full pt-2 w-52">
                                        <div class="bg-[#1c1628] border border-[#2e2640] rounded-md shadow-xl py-2">

                                            <div class="px-4 py-2 border-b border-[#2e2640]">
                                                <div class="text-sm font-medium text-white truncate">{{ app.user.pseudo }}</div>
                                            </div>

                                            <a href="{{ path('app_tableau_de_bord') }}" class="block px-4 py-2 text-sm text-[#b9b0cc] hover:bg-[#2e2640] hover:text-white transition">Tableau de bord</a>
                                            <a href="{{ path('app_profil') }}" class="block px-4 py-2 text-sm text-[#b9b0cc] hover:bg-[#2e2640] hover:text-white transition">Mon profil</a>
                                            <a href="{{ path('app_commandes') }}" class="block px-4 py-2 text-sm text-[#b9b0cc] hover:bg-[#2e2640] hover:text-white transition">Mes commandes</a>
                                            <a href="{{ path('app_ventes', {'vendeurId': app.user.id}) }}" class="block px-4 py-2 text-sm text-[#b9b0cc] hover:bg-[#2e2640] hover:text-white transition">Mes ventes</a>
                                            {% if is_granted('ROLE_ADMIN') %}
                                                <a href="{{ path('app_admin_signalements') }}" class="block px-4 py-2 text-sm text-[#f5a623] hover:bg-[#2e2640] hover:text-white transition">Signalements (admin)</a>
                                            {% endif %}
                                            <a href="{{ path('app_wishlist') }}" class="block px-4 py-2 text-sm text-[#b9b0cc] hover:bg-[#2e2640] hover:text-white transition">Ma liste de souhaits</a>

                                            <div class="border-t border-[#2e2640] mt-2 pt-2">
                                                <a href="{{ path('app_logout') }}" class="block px-4 py-2 text-sm text-[#ff8a80] hover:bg-[#2e2640] transition">Se déconnecter</a>
                                            </div>

                                        </div>
                                    </div>
                                </details>
                            {% else %}
                                <a href="{{ path('app_login') }}" class="text-[#b9b0cc] hover:text-[#f5a623] transition" title="Se connecter">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                </a>
                            {% endif %}

                            {# Bouton burger - mobile seulement #}
                            <button id="burger" class="md:hidden text-[#b9b0cc] hover:text-[#f5a623] transition" title="Menu">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                                </svg>
                            </button>

                        </div>
                    </div>
                </div>

                {# Menu mobile déroulant #}
                <div id="mobile-menu" class="hidden md:hidden border-t border-[#2e2640] px-4 pb-4 pt-4 space-y-2 bg-[#110d1b]">

                    <form method="GET" action="{{ path('app_jeux_liste') }}" class="pb-2">
                        <div class="relative">
                            <svg class="w-4 h-4 text-[#8a82a0] absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
                            </svg>
                            <input
                                type="text"
                                name="q"
                                value="{{ app.request.query.get('q') }}"
                                placeholder="Rechercher un jeu..."
                                class="w-full bg-[#1c1628] border border-[#2e2640] text-sm text-white placeholder-[#8a82a0] rounded-md pl-9 pr-3 py-2 focus:outline-none focus:border-[#f5a623] transition"
                            >
                        </div>
                    </form>

                    <a href="{{ path('app_jeux_liste') }}" class="block text-[#b9b0cc] hover:text-[#f5a623] py-2">Acheter un jeu</a>
                    <a href="{{ app.user ? path('app_jeu_vendre') : path('app_login') }}" class="block text-[#b9b0cc] hover:text-[#f5a623] py-2">Vendre un jeu</a>
                    <a href="{{ app.user ? path('app_wishlist') : path('app_login') }}" class="block text-[#b9b0cc] hover:text-[#f5a623] py-2">Liste de souhaits</a>
                </div>

            </nav>
        </header>

        {% endblock %}

        {# Messages flash (ajout au panier, wishlist, signalement…), affichés sur toutes les pages #}
        <div class="max-w-6xl mx-auto px-4 pt-6">
            {% for message in app.flashes('success') %}
                <div class="mb-4 rounded-md bg-[#9ae6b4]/10 border border-[#9ae6b4]/30 text-[#9ae6b4] px-4 py-3 text-sm">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="mb-4 rounded-md bg-[#ff8a80]/10 border border-[#ff8a80]/30 text-[#ff8a80] px-4 py-3 text-sm">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('danger') %}
                <div class="mb-4 rounded-md bg-[#ff8a80]/10 border border-[#ff8a80]/30 text-[#ff8a80] px-4 py-3 text-sm">{{ message }}</div>
            {% endfor %}
        </div>

        {% block body %}

        {% endblock %}

        <footer class="mt-16 border-t border-[#2e2640] bg-[#110d1b]">
            <div class="max-w-6xl mx-auto px-4 py-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                <p class="text-sm text-[#8a82a0]">&copy; {{ 'now'|date('Y') }} Replay. Site fictif à des fins de démonstration.</p>
                <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
                    <a href="{{ path('app_mentions') }}" class="text-[#b9b0cc] hover:text-[#f5a623] transition">Mentions légales</a>
                    <a href="{{ path('app_cgv') }}" class="text-[#b9b0cc] hover:text-[#f5a623] transition">CGV</a>
                    <a href="{{ path('app_confidentialite') }}" class="text-[#b9b0cc] hover:text-[#f5a623] transition">Confidentialité</a>
                </nav>
            </div>
        </footer>
    </body>
</html>
