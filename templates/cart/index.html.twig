{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 py-10">

    <h1 class="text-2xl font-bold text-white mb-6">Panier</h1>

    {% if jeux is empty %}
        <div class="bg-[#1c1628] rounded-lg border border-[#2e2640] p-10 text-center">
            <p class="text-[#b9b0cc] text-lg mb-4">Ton panier est vide.</p>
            <a href="{{ path('app_home') }}" class="inline-block bg-[#f5a623] hover:bg-[#ffb84d] text-[#111] font-bold text-sm px-6 py-2.5 rounded-md transition">
                Continuer mes achats
            </a>
        </div>
    {% else %}
        <div class="flex flex-col lg:flex-row gap-6">

            {# Liste des articles #}
            <div class="flex-1 bg-[#1c1628] rounded-lg border border-[#2e2640]">
                <div class="flex justify-between items-center px-6 py-4 border-b border-[#2e2640]">
                    <h2 class="font-semibold text-white">
                        {{ jeux|length }} article{{ jeux|length > 1 ? 's' : '' }}
                    </h2>

                    <form action="{{ path('app_cart_clear') }}" method="post">
                        <button type="submit" class="text-sm text-[#ff8a80] hover:text-white hover:underline transition">
                            Vider le panier
                        </button>
                    </form>
                </div>
                <ul class="divide-y divide-[#2e2640]">
                    {% set total = 0 %}
                    {% for item in jeux %}
                        {# Un jeu vendu reste visible mais ne compte pas dans le total #}
                        {% if item.jeu.statut.name == 'EN_VENTE' %}
                            {% set total = total + (item.jeu.prix * item.quantity) %}
                        {% endif %}
                        {% set isModified = item.panierItem is defined and item.panierItem and item.jeu.getMiseAJour() and item.jeu.getMiseAJour() > item.panierItem.getMiseAJour() %}

                        <li class="flex flex-col gap-4 p-6">
                            <!-- Alerte si modifié -->
                            {% if isModified %}
                                <div class="bg-[#f5a623]/10 border border-[#f5a623]/40 text-[#f5a623] rounded-md px-4 py-3 flex items-start gap-3">
                                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                    </svg>
                                    <div class="flex-1">
                                        <p class="font-medium">Ce jeu a été modifié depuis son ajout au panier</p>
                                        <p class="text-sm mt-1 text-[#b9b0cc]">Vérifie que les informations te conviennent toujours</p>
                                    </div>
                                </div>
                            {% endif %}

                            <!-- Alerte si vendu -->
                            {% if item.jeu.statut.name != 'EN_VENTE' %}
                                <div class="bg-[#ff8a80]/10 border border-[#ff8a80]/40 text-[#ff8a80] rounded-md px-4 py-3 text-sm font-medium">
                                    Ce jeu est vendu. Il sera retiré de ton panier au moment du paiement.
                                </div>
                            {% endif %}

                            <div class="flex items-center gap-4">
                                <img src="{{ item.jeu.image ?? '' }}"
                                     alt="{{ item.jeu.titre }}"
                                     class="w-24 h-24 object-cover rounded-md border border-[#2e2640] bg-[#2a2040] flex-shrink-0">

                                <div class="flex-1 min-w-0">
                                    <h3 class="font-medium text-white truncate">{{ item.jeu.titre }}</h3>

                                    {# Si le prix a changé, l'ancien est affiché barré au-dessus du nouveau #}
                                    <div>
                                        {% if item.jeu.prixPrecedent %}
                                            <p class="text-xs text-[#8a82a0] line-through">{{ item.jeu.prixPrecedent }} €</p>
                                        {% endif %}
                                        <p class="text-sm text-[#8a82a0] mt-1">{{ item.jeu.prix }} € / unité</p>
                                    </div>

                                    <div class="flex items-center gap-4 mt-3">

                                        <form action="{{ path('app_cart_remove', {id: item.jeu.id}) }}" method="post">
                                            <button type="submit" class="text-sm text-[#b9b0cc] hover:text-[#ff8a80] hover:underline transition">
                                                Supprimer
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="text-right flex-shrink-0">
                                    <p class="font-bold text-[#f5a623]">
                                        {{ (item.jeu.prix * item.quantity)|number_format(2, ',', ' ') }} €
                                    </p>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            {# Résumé de commande #}
            <div class="w-full lg:w-80 flex-shrink-0">
                <div class="bg-[#1c1628] rounded-lg border border-[#2e2640] p-6 sticky top-24">
                    <h2 class="font-semibold text-white mb-4">Résumé de la commande</h2>

                    <div class="flex justify-between text-sm text-[#b9b0cc] mb-2">
                        <span>Sous-total ({{ jeux|length }} article{{ jeux|length > 1 ? 's' : '' }})</span>
                        <span>{{ total|number_format(2, ',', ' ') }} €</span>
                    </div>

                    <div class="flex justify-between text-sm text-[#b9b0cc] mb-4">
                        <span>Livraison</span>
                        <span class="text-[#9ae6b4] font-medium">Gratuite</span>
                    </div>

                    <!-- Code promo -->
                    <div class="mb-4 pb-4 border-b border-[#2e2640]">
                        <form action="{{ path('app_apply_promo') }}" method="post" class="flex gap-2">
                            <input type="text" name="promo_code" placeholder="Code promo"
                                   class="flex-1 px-3 py-2 bg-[#110d1b] border border-[#2e2640] rounded-md text-sm text-white placeholder-[#8a82a0] focus:outline-none focus:border-[#f5a623] transition">
                            <button type="submit" class="bg-[#2e2640] hover:bg-[#3a3152] text-white px-4 py-2 rounded-md text-sm font-medium transition">
                                Appliquer
                            </button>
                        </form>
                    </div>

                    {% if promoApplied %}
                        <div class="flex justify-between items-center text-sm text-[#9ae6b4] mb-2">
                            <span>Réduction ({{ promoCode.getPourcentage() }}%)</span>
                            <div class="flex items-center gap-3">
                                <span>-{{ discount|number_format(2, ',', ' ') }} €</span>
                                <form action="{{ path('app_remove_promo') }}" method="post" style="display:inline;">
                                    <button type="submit" class="text-xs text-[#8a82a0] hover:text-[#ff8a80] underline">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endif %}

                    <div class="border-t border-[#2e2640] pt-4 mb-6">
                        <div class="flex justify-between text-lg font-bold text-white">
                            <span>Total</span>
                            <span class="text-[#f5a623]">{{ (total - (discount ?? 0))|number_format(2, ',', ' ') }} €</span>
                        </div>
                    </div>

                    <form action="{{ path('app_stripe_checkout') }}" method="post">
                        <button type="submit" class="w-full bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-3 rounded-md transition">
                            Valider la commande
                        </button>
                    </form>

                    <a href="{{ path('app_home') }}" class="block text-center text-sm text-[#b9b0cc] hover:text-[#f5a623] mt-4 hover:underline transition">
                        Continuer mes achats
                    </a>
                </div>
            </div>

        </div>
    {% endif %}

</div>
{% endblock %}
