{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 py-8">

    <h1 class="text-2xl font-semibold text-slate-800 mb-6">Panier</h1>

    {% for message in app.flashes('success') %}
        <div class="mb-4 rounded-lg bg-green-50 border border-green-200 text-green-700 px-4 py-3 text-sm">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm">
            {{ message }}
        </div>
    {% endfor %}

    {% if jeux is empty %}
        <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-10 text-center">
            <p class="text-slate-500 text-lg mb-4">Ton panier est vide.</p>
            <a href="{{ path('app_home') }}" class="inline-block bg-amber-400 hover:bg-amber-500 text-slate-900 font-medium px-6 py-2 rounded-full transition">
                Continuer mes achats
            </a>
        </div>
    {% else %}
        <div class="flex flex-col lg:flex-row gap-6">

            {# Liste des articles #}
            <div class="flex-1 bg-white rounded-lg shadow-sm border border-slate-200">
                <div class="flex justify-between items-center px-6 py-4 border-b border-slate-200">
                    <h2 class="font-semibold text-slate-700">
                        {{ jeux|length }} article{{ jeux|length > 1 ? 's' : '' }}
                    </h2>

                    <form action="{{ path('app_cart_clear') }}" method="post">
                        <button type="submit" class="text-sm text-red-600 hover:text-red-800 hover:underline transition">
                            Vider le panier
                        </button>
                    </form>
                </div>
                <ul class="divide-y divide-slate-200">
                    {% set total = 0 %}
                    {% for item in jeux %}
                        {% set total = total + (item.jeu.prix * item.quantity) %}
                        {% set isModified = item.panierItem and item.jeu.getMiseAJour() and item.jeu.getMiseAJour() > item.panierItem.getMiseAJour() %}

                        <li class="flex flex-col gap-4 p-6">
                            <!-- Alerte si modifié -->
                            {% if isModified %}
                                <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg px-4 py-3 flex items-start gap-3">
                                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                    </svg>
                                    <div class="flex-1">
                                        <p class="font-medium">Ce jeu a été modifié depuis son ajout au panier</p>
                                        <p class="text-sm mt-1">Vérifie que les informations te conviennent toujours</p>
                                    </div>
                                </div>
                            {% endif %}

                            <div class="flex items-center gap-4">
                                <img src="{{ item.jeu.image ?? '' }}"
                                     alt="{{ item.jeu.titre }}"
                                     class="w-24 h-24 object-cover rounded-md border border-slate-100 flex-shrink-0">

                                <div class="flex-1 min-w-0">
                                    <h3 class="font-medium text-slate-800 truncate">{{ item.jeu.titre }}</h3>
                                    <p class="text-sm text-slate-500 mt-1">{{ item.jeu.prix }} € / unité</p>

                                    <div class="flex items-center gap-4 mt-3">

                                        <form action="{{ path('app_cart_remove', {id: item.jeu.id}) }}" method="post">
                                            <button type="submit" class="text-sm text-slate-500 hover:text-red-600 hover:underline transition">
                                                Supprimer
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="text-right flex-shrink-0">
                                    <p class="font-semibold text-slate-800">
                                        {{ (item.jeu.prix * item.quantity)|number_format(2, ',', ' ') }} €
                                    </p>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            {# Résumé de commande #}
            <div class="w-full lg:w-80 flex-shrink-0">
                <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6 sticky top-6">
                    <h2 class="font-semibold text-slate-700 mb-4">Résumé de la commande</h2>

                    <div class="flex justify-between text-sm text-slate-600 mb-2">
                        <span>Sous-total ({{ jeux|length }} article{{ jeux|length > 1 ? 's' : '' }})</span>
                        <span>{{ total|number_format(2, ',', ' ') }} €</span>
                    </div>

                    <div class="flex justify-between text-sm text-slate-600 mb-4">
                        <span>Livraison</span>
                        <span class="text-green-600 font-medium">Gratuite</span>
                    </div>

                    <!-- Code promo -->
                    <div class="mb-4 pb-4 border-b border-slate-200">
                        <form action="{{ path('app_apply_promo') }}" method="post" class="flex gap-2">
                            <input type="text" name="promo_code" placeholder="Code promo" 
                                   class="flex-1 px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-400 focus:border-transparent">
                            <button type="submit" class="bg-slate-600 hover:bg-slate-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition">
                                Appliquer
                            </button>
                        </form>
                    </div>

                    {% if promoApplied %}
                        <div class="flex justify-between items-center text-sm text-green-600 mb-2">
                            <span>Réduction ({{ promoCode.getPourcentage() }}%)</span>
                            <div class="flex items-center gap-3">
                                <span>-{{ discount|number_format(2, ',', ' ') }} €</span>
                                <form action="{{ path('app_remove_promo') }}" method="post" style="display:inline;">
                                    <button type="submit" class="text-xs text-slate-500 hover:text-red-600 underline">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endif %}

                    <div class="border-t border-slate-200 pt-4 mb-6">
                        <div class="flex justify-between text-lg font-semibold text-slate-800">
                            <span>Total</span>
                            <span>{{ (total - (discount ?? 0))|number_format(2, ',', ' ') }} €</span>
                        </div>
                    </div>

                    <form action="{{ path('app_cart_checkout') }}" method="post">
                        <button type="submit" class="w-full bg-amber-400 hover:bg-amber-500 text-slate-900 font-medium py-3 rounded-full transition">
                            Valider la commande
                        </button>
                    </form>

                    <a href="{{ path('app_home') }}" class="block text-center text-sm text-slate-500 hover:text-slate-700 mt-4 hover:underline transition">
                        Continuer mes achats
                    </a>
                </div>
            </div>

        </div>
    {% endif %}

</div>
{% endblock %}