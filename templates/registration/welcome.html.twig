    <h1 style="font-size: 22px; font-weight: bold; margin: 0 0 24px 0; color: #ffffff;">
        Bienvenue {{ user.pseudo }} !
    </h1>

    <p style="font-size: 15px; line-height: 1.6; margin: 0 0 20px 0; color: #b9b0cc;">
