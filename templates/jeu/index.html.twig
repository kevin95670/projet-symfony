{% extends 'base.html.twig' %}

{% block title %}Hello JeuController!{% endblock %}

{% block body %}

<div class="max-w-7xl mx-auto px-4 py-12">
    {% if jeu.image %}
        <img src="{{ jeu.image }}" alt="{{ jeu.titre }}" class="w-full h-auto mb-6 rounded-lg">
        {% else %}
        <div class="w-full h-full flex items-center justify-center text-slate-600 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
        </div>
    {% endif %}
    <h1>{{ jeu.titre }}</h1>
    <p>{{ jeu.description }}</p>
    <p>Prix: {{ jeu.prix }} €</p>
    <p>Etat: {{ jeu.etat.value }}</p>
    {% if jeu.pegi %}
        <p>PEGI: {{ jeu.pegi.value }}</p>
    {% endif %}
    <p>Plateforme: {{ jeu.plateforme }}</p>
    <p>Vendu par: <a href="{{ path('vue_vendeur', {'pseudo': jeu.vendeur.pseudo}) }}">{{ jeu.vendeur.pseudo }}</a></p>
</div>
{% endblock %}
