{% extends 'base.html.twig' %}

{% block title %}{{ jeu.titre }} — {{ jeu.prix }} €{% endblock %}

{% block og %}
    <meta property="og:site_name" content="Replay">
    <meta property="og:type" content="product">
    <meta property="og:title" content="{{ jeu.titre }} — {{ jeu.prix|number_format(2, ',', ' ') }} €">
    <meta property="og:description" content="{{ jeu.description ? jeu.description|slice(0, 200) : 'Jeu d\'occasion à acheter sur Replay.' }}">
    <meta property="og:url" content="{{ url('app_jeu', {'slug': jeu.slug, 'id': jeu.id}) }}">
    {% if jeu.image %}
        <meta property="og:image" content="{{ absolute_url(jeu.image) }}">
    {% endif %}
{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto px-4 py-12">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

        {# Colonne image #}
        <div class="aspect-[4/3] bg-[#2a2040] border border-[#2e2640] rounded-lg overflow-hidden">
            {% if jeu.image %}
                <img src="{{ jeu.image }}" alt="{{ jeu.titre }}" class="w-full h-full object-cover">
            {% else %}
                <div class="w-full h-full flex items-center justify-center text-[#5d5573]">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-20 h-20">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                    </svg>
                </div>
            {% endif %}
        </div>

        {# Colonne informations #}
        <div class="flex flex-col">

            <h1 class="text-3xl font-bold text-white leading-tight mb-3">{{ jeu.titre }}</h1>

            {# Si le prix a changé, l'ancien est affiché barré au-dessus du nouveau #}
            <div class="mb-6">
                {% if jeu.prixPrecedent %}
                    <span class="block text-lg text-[#8a82a0] line-through">{{ jeu.prixPrecedent|number_format(2, ',', ' ') }} €</span>
                {% endif %}
                <div class="text-4xl font-extrabold text-[#f5a623]">{{ jeu.prix|number_format(2, ',', ' ') }} €</div>
            </div>

            <div class="flex flex-wrap gap-2 mb-6">
                <span class="px-3 py-1 text-sm rounded-sm bg-[#1c1628] border border-[#2e2640] text-[#b9b0cc]">{{ jeu.plateforme.value }}</span>
                <span class="px-3 py-1 text-sm rounded-sm bg-[#1c1628] border border-[#2e2640] text-[#b9b0cc]">{{ jeu.etat.value }}</span>
                {% if jeu.pegi %}
                    <span class="px-3 py-1 text-sm rounded-sm bg-[#1c1628] border border-[#2e2640] text-[#b9b0cc]">PEGI {{ jeu.pegi.value }}</span>
                {% endif %}
            </div>

            <p class="text-[#b9b0cc] leading-relaxed mb-8">{{ jeu.description }}</p>

            {# Bandeau pour le vendeur si l'annonce est masquée #}
            {% if masque and estVendeur %}
                <div class="mb-6 px-4 py-3 rounded-md bg-[#ff8a80]/10 border border-[#ff8a80]/40 text-[#ff8a80] text-sm">
                    Ton annonce est masquée suite à un signalement. Elle sera rétablie si l'équipe la valide.
                </div>
            {% endif %}

            {# Signalement (acheteurs connectés, une seule fois par jeu) #}
            {% if app.user and not estVendeur and not dejaSignale %}
                <details class="mb-8 bg-[#1c1628] border border-[#2e2640] rounded-lg p-4">
                    <summary class="cursor-pointer text-sm text-[#b9b0cc] hover:text-white">Signaler cette annonce</summary>
                    <form action="{{ path('app_jeu_signaler', {'id': jeu.id}) }}" method="post" class="mt-4 space-y-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('signaler-' ~ jeu.id) }}">
                        <select name="motif" required class="w-full bg-[#110d1b] border border-[#2e2640] text-sm text-white rounded-md px-3 py-2">
                            <option value="">Choisis un motif</option>
                            <option value="contenu_trompeur">Annonce trompeuse</option>
                            <option value="photo_inappropriee">Photo inappropriée</option>
                            <option value="contrefacon">Jeu contrefait ou copie illégale</option>
                            <option value="autre">Autre</option>
                        </select>
                        <textarea name="commentaire" rows="3" maxlength="500" placeholder="Précisions (facultatif)"
                                  class="w-full bg-[#110d1b] border border-[#2e2640] text-sm text-white rounded-md p-3"></textarea>
                        <button type="submit" class="bg-[#ff8a80] hover:bg-white text-[#111] font-bold text-sm py-2 px-4 rounded-md transition">Envoyer le signalement</button>
                    </form>
                </details>
            {% elseif app.user and not estVendeur and dejaSignale %}
                <p class="mb-8 text-sm text-[#8a82a0]">Tu as déjà signalé cette annonce.</p>
            {% endif %}

            {# Vendeur #}
            <div class="flex items-center gap-3 p-4 bg-[#1c1628] border border-[#2e2640] rounded-lg mb-8">
                <img class="w-10 h-10 rounded-full bg-[#2a2040] shrink-0"
                     src="https://api.dicebear.com/9.x/avataaars/svg?seed={{ jeu.vendeur.pseudo }}"
                     alt="">
                <div class="min-w-0">
                    <div class="text-xs text-[#8a82a0]">Vendu par</div>
                    <a href="{{ path('vue_vendeur', {'pseudo': jeu.vendeur.pseudo}) }}"
                       class="font-medium text-white hover:text-[#f5a623] transition">{{ jeu.vendeur.pseudo }}</a>
                </div>
            </div>

            {# Actions #}
            <div class="flex flex-col sm:flex-row gap-3 mt-auto">
                {% if estVendeur %}
                    <span class="flex-1 text-center bg-[#2e2640] text-[#8a82a0] font-bold text-sm py-3 px-6 rounded-md">C'est votre annonce</span>
                {% elseif dansPanier %}
                    <a href="{{ path('app_cart') }}" class="flex-1 text-center border border-[#f5a623] text-[#f5a623] hover:bg-[#f5a623]/10 font-bold text-sm py-3 px-6 rounded-md transition">
                        Déjà dans le panier : voir le panier
                    </a>
                {% else %}
                    <form action="{{ path('app_jeu_cart_toggle', {'id': jeu.id}) }}" method="post" class="flex-1">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-cart-' ~ jeu.id) }}">
                        <button type="submit" class="w-full text-center bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-3 px-6 rounded-md transition">
                            Ajouter au panier
                        </button>
                    </form>
                {% endif %}

                {% if app.user %}
                    <form action="{{ path('app_jeu_wishlist_toggle', {'id': jeu.id}) }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-wishlist-' ~ jeu.id) }}">
                        <button type="submit" class="flex items-center justify-center gap-2 border font-medium text-sm py-3 px-6 rounded-md transition
                                {% if dansWishlist %}border-[#f5a623] bg-[#f5a623]/10 text-[#f5a623] hover:bg-[#f5a623]/20{% else %}border-[#2e2640] hover:border-[#f5a623] text-[#b9b0cc] hover:text-white{% endif %}">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                            </svg>
                            {{ dansWishlist ? 'Dans ta wishlist' : 'Wishlist' }}
                        </button>
                    </form>
                {% else %}
                    <a href="{{ path('app_login') }}" class="flex items-center justify-center gap-2 border border-[#2e2640] hover:border-[#f5a623] text-[#b9b0cc] hover:text-white font-medium text-sm py-3 px-6 rounded-md transition">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                        </svg>
                        Wishlist
                    </a>
                {% endif %}
            </div>

        </div>
    </div>

    {# Section questions au vendeur (fil privé entre un acheteur et le vendeur) #}
    <div class="max-w-6xl mx-auto px-4 py-12 border-t border-[#2e2640] mt-12">
        <h2 class="text-2xl font-bold text-white mb-2">Questions au vendeur</h2>

        {% if estVendeur %}
            <p class="text-sm text-[#8a82a0] mb-6">Seuls toi et l'acheteur concerné voient chaque fil.</p>

            {# Liste des acheteurs qui ont écrit #}
            {% if filsVendeur|length == 0 %}
                <p class="text-[#8a82a0] mb-8">Aucun acheteur ne t'a encore écrit pour ce jeu.</p>
            {% else %}
                <div class="flex flex-wrap gap-2 mb-8">
                    {% for acheteur in filsVendeur %}
                        <a href="{{ path('app_jeu', {'slug': jeu.slug, 'id': jeu.id, 'fil': acheteur.id}) }}"
                           class="px-3 py-1.5 text-sm rounded-md border transition
                                  {{ acheteurActif and acheteurActif.id == acheteur.id ? 'border-[#f5a623] text-[#f5a623]' : 'border-[#2e2640] text-[#b9b0cc] hover:border-[#f5a623]' }}">
                            {{ acheteur.pseudo }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        {% elseif app.user %}
            <p class="text-sm text-[#8a82a0] mb-6">Tes questions sont visibles uniquement par toi et le vendeur.</p>
        {% endif %}

        {# Fil ouvert : celui de l'acheteur connecté, ou celui choisi par le vendeur #}
        {% if (estVendeur and acheteurActif) or (not estVendeur and app.user) %}

            {% if fil|length > 0 %}
                <div class="space-y-4 mb-8">
                    {% for message in fil %}
                        {% if message.isDeleted %}
                            <div class="p-4 bg-[#1c1628] border border-[#2e2640] rounded-lg opacity-50">
                                <p class="text-[#8a82a0] italic">Ce message a été supprimé</p>
                            </div>
                        {% else %}
                            <div class="p-4 bg-[#1c1628] border border-[#2e2640] rounded-lg" data-comment-id="{{ message.id }}">
                                <div class="flex justify-between items-start mb-2">
                                    <div>
                                        <p class="font-semibold text-white">
                                            {{ message.auteur.pseudo }}
                                            {% if message.auteur == jeu.vendeur %}
                                                <span class="ml-2 px-2 py-0.5 text-xs rounded-sm bg-[#f5a623]/15 text-[#f5a623] border border-[#f5a623]/40">Vendeur</span>
                                            {% endif %}
                                        </p>
                                        <p class="text-sm text-[#8a82a0]">{{ message.dateCreation|date('d/m/Y H:i') }}</p>
                                        {% if message.dateModification %}
                                            <p class="text-xs text-[#5d5573]">Modifié le {{ message.dateModification|date('d/m/Y H:i') }}</p>
                                        {% endif %}
                                    </div>
                                    {% if app.user and app.user == message.auteur %}
                                        <div class="flex gap-2">
                                            <button type="button" class="text-sm text-[#f5a623] hover:text-white btn-edit-comment" data-comment-id="{{ message.id }}">Modifier</button>
                                            <form action="{{ path('app_comment_delete', {'jeuId': jeu.id, 'commentId': message.id}) }}" method="post" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-comment-' ~ message.id) }}">
                                                <button type="submit" class="text-sm text-[#ff8a80] hover:text-white" onclick="return confirm('Supprimer ?')">Supprimer</button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </div>

                                {# Contenu du message (visible par défaut) #}
                                <p class="text-[#b9b0cc] comment-content">{{ message.contenu }}</p>

                                {# Formulaire d'édition (caché par défaut) #}
                                <div class="comment-edit-form hidden mt-4">
                                    <form action="{{ path('app_comment_update', {'jeuId': jeu.id, 'commentId': message.id}) }}" method="post">
                                        <textarea name="comment[contenu]"
                                                  class="w-full p-3 bg-[#110d1b] border border-[#2e2640] rounded-md text-white placeholder-[#5d5573] focus:outline-none focus:border-[#f5a623] resize-none"
                                                  rows="4"
                                                  required>{{ message.contenu }}</textarea>
                                        <div class="flex gap-2 mt-3">
                                            <button type="submit" class="bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-2 px-4 rounded-md transition">
                                                Valider
                                            </button>
                                            <button type="button" class="btn-cancel-edit border border-[#2e2640] hover:border-[#f5a623] text-[#b9b0cc] hover:text-white font-medium text-sm py-2 px-4 rounded-md transition">
                                                Annuler
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-[#8a82a0] mb-8">Aucun message pour le moment.</p>
            {% endif %}

            {# Formulaire d'envoi : le vendeur répond à l'acheteur choisi, l'acheteur écrit au vendeur #}
            <div class="p-4 bg-[#1c1628] border border-[#2e2640] rounded-lg">
                <form action="{{ path('app_comment_create', {'jeuId': jeu.id}) }}" method="post">
                    {% if estVendeur %}
                        <input type="hidden" name="acheteurId" value="{{ acheteurActif.id }}">
                    {% endif %}
                    <textarea name="comment[contenu]"
                              placeholder="{{ estVendeur ? 'Répondre à ' ~ acheteurActif.pseudo ~ '...' : 'Pose ta question au vendeur...' }}"
                              class="w-full p-3 bg-[#110d1b] border border-[#2e2640] rounded-md text-white placeholder-[#5d5573] focus:outline-none focus:border-[#f5a623] resize-none"
                              rows="4"
                              required></textarea>
                    <button type="submit" class="mt-3 bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-2 px-6 rounded-md transition">
                        Envoyer
                    </button>
                </form>
            </div>

        {% elseif estVendeur %}
            <p class="text-[#8a82a0]">Choisis un acheteur pour afficher son fil.</p>

        {% else %}
            <div class="p-4 bg-[#1c1628] border border-[#2e2640] rounded-lg text-center">
                <p class="text-[#b9b0cc]"><a href="{{ path('app_login') }}" class="text-[#f5a623] hover:text-white">Connecte-toi</a> pour poser une question au vendeur</p>
            </div>
        {% endif %}
    </div>

</div>

<script src="{{ asset('scripts/commentaire.js') }}"></script>
{% endblock %}
