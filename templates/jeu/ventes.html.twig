{% extends "base.html.twig" %}

{% block title %}Mes ventes{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- En-tête -->
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Mes ventes</h1>
            <p class="mt-2 text-[#b9b0cc]">Gérez vos jeux en vente</p>
        </div>
        <a href="{{ path('app_jeu_vendre') }}" class="inline-flex items-center px-5 py-2.5 bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm rounded-md transition-colors">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Ajouter un jeu
        </a>
    </div>

    {% if ventes|length > 0 %}
        <!-- Tableau responsive -->
        <div class="overflow-x-auto bg-[#1c1628] border border-[#2e2640] rounded-lg">
            <table class="w-full">
                <thead>
                    <tr class="bg-[#110d1b] border-b border-[#2e2640]">
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#8a82a0] uppercase tracking-wider">Titre</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#8a82a0] uppercase tracking-wider">Console</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#8a82a0] uppercase tracking-wider">Prix</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#8a82a0] uppercase tracking-wider">État</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#8a82a0] uppercase tracking-wider">Statut</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#8a82a0] uppercase tracking-wider">Date d'ajout</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-[#8a82a0] uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#2e2640]">
                    {% for jeu in ventes %}
                        <tr class="hover:bg-[#2a2040]/50 transition-colors">
                            <!-- Titre -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm font-medium text-white">{{ jeu.titre }}</span>
                            </td>

                            <!-- Console -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-3 py-1 rounded-sm text-xs font-medium bg-[#f5a623]/15 text-[#f5a623] border border-[#f5a623]/40">
                                    {{ jeu.plateforme.value }}
                                </span>
                            </td>

                            <!-- Prix -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm font-bold text-[#f5a623]">{{ jeu.prix }}€</span>
                            </td>

                            <!-- État -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if jeu.etat.value == 'Neuf' %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-sm text-xs font-medium bg-[#1e4d2b] text-[#9ae6b4]">
                                        {{ jeu.etat.value }}
                                    </span>
                                {% elseif jeu.etat.value == 'Bon état' %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-sm text-xs font-medium bg-[#f5a623]/15 text-[#f5a623]">
                                        {{ jeu.etat.value }}
                                    </span>
                                {% elseif jeu.etat.value == 'État moyen' %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-sm text-xs font-medium bg-[#2e2640] text-[#b9b0cc]">
                                        {{ jeu.etat.value }}
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-sm text-xs font-medium bg-[#ff8a80]/15 text-[#ff8a80]">
                                        {{ jeu.etat.value }}
                                    </span>
                                {% endif %}
                            </td>

                            <!-- Statut -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                {% if jeu.statut.value == 'Vendu' %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-sm text-xs font-medium bg-[#2e2640] text-[#8a82a0]">
                                        Vendu
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center px-3 py-1 rounded-sm text-xs font-medium bg-[#1e4d2b] text-[#9ae6b4]">
                                        Disponible
                                    </span>
                                {% endif %}
                            </td>

                            <!-- Date d'ajout -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-xs text-[#8a82a0]">{{ jeu.dateCreation|date('d/m/Y') }}</span>
                            </td>

                            <!-- Actions -->
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex gap-2">
                                    <!-- Voir -->
                                    <a href="{{ path('app_jeu', {'slug': jeu.slug, 'id': jeu.id}) }}"
                                       class="inline-flex items-center justify-center w-8 h-8 text-[#f5a623] bg-[#f5a623]/10 border border-[#f5a623]/30 rounded-md hover:bg-[#f5a623]/20 transition-colors"
                                       title="Voir">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                    </a>

                                    <!-- Modifier -->
                                    <a href="{{ path('app_jeu_modifier', {'slug': jeu.slug, 'id': jeu.id}) }}"
                                       class="inline-flex items-center justify-center w-8 h-8 text-[#f5a623] bg-[#f5a623]/10 border border-[#f5a623]/30 rounded-md hover:bg-[#f5a623]/20 transition-colors"
                                       title="Modifier">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                        </svg>
                                    </a>

                                    <!-- Supprimer -->
                                    <form method="POST"
                                          action="{{ path('app_jeu_delete', {'id': jeu.id}) }}"
                                          style="display:inline;"
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce jeu ?');">
                                        <input type="hidden" name="_method" value="DELETE">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ jeu.id) }}">
                                        <button type="submit"
                                                class="inline-flex items-center justify-center w-8 h-8 text-[#ff8a80] bg-[#ff8a80]/10 border border-[#ff8a80]/30 rounded-md hover:bg-[#ff8a80]/20 transition-colors"
                                                title="Supprimer">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Résumé des statistiques -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8">
            <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[#b9b0cc] text-sm font-medium">Total de jeux</p>
                        <p class="text-3xl font-bold text-white mt-1">{{ ventes|length }}</p>
                    </div>
                    <div class="bg-[#f5a623]/10 border border-[#f5a623]/30 rounded-md p-3">
                        <svg class="w-6 h-6 text-[#f5a623]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[#b9b0cc] text-sm font-medium">Disponibles</p>
                        <p class="text-3xl font-bold text-[#9ae6b4] mt-1">{{ ventes|filter(v => not v.statut.value == 'Vendu')|length }}</p>
                    </div>
                    <div class="bg-[#1e4d2b] rounded-md p-3">
                        <svg class="w-6 h-6 text-[#9ae6b4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[#b9b0cc] text-sm font-medium">Vendus</p>
                        <p class="text-3xl font-bold text-[#b9b0cc] mt-1">{{ ventes|filter(v => v.statut.value == 'Vendu')|length }}</p>
                    </div>
                    <div class="bg-[#2e2640] rounded-md p-3">
                        <svg class="w-6 h-6 text-[#b9b0cc]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

    {% else %}
        <!-- Message d'absence de ventes -->
        <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-8 text-center">
            <svg class="w-16 h-16 mx-auto text-[#f5a623] mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h2 class="text-2xl font-bold text-white mb-2">Aucun jeu en vente</h2>
            <p class="text-[#b9b0cc] mb-6">
                Vous n'avez pas encore mis de jeu en vente. Commencez à vendre vos jeux vidéo favoris dès maintenant !
            </p>
            <a href="{{ path('app_jeu_vendre') }}" class="inline-flex items-center px-6 py-3 bg-white hover:bg-[#f5a623] text-[#111] rounded-md transition-colors font-bold text-sm">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Ajouter votre premier jeu
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
