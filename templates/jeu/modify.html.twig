{% extends "base.html.twig" %}

{% block title %}Modifier - {{ jeu.titre }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- En-tête avec bouton retour -->
    <div class="mb-8">
        <a href="{{ path('app_ventes', {'vendeurId': jeu.vendeur.id}) }}" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 mb-4 inline-flex items-center gap-1 transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Retour
        </a>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Modifier le jeu</h1>
        <p class="mt-2 text-gray-600 dark:text-gray-400">{{ jeu.titre }}</p>
    </div>

    <!-- Formulaire -->
    <div class="bg-white dark:bg-slate-900 rounded-lg shadow p-6 sm:p-8">
        {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

        <!-- Titre -->
        <div>
            {{ form_label(form.titre, 'Titre', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 dark:text-white mb-2'}}) }}
            {{ form_widget(form.titre, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-900 placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition', 'style': 'color: #000 !important;'}}) }}
            {% if form.titre.vars.errors %}
                <div class="mt-1 text-sm text-red-600 dark:text-red-400">
                    {{ form_errors(form.titre) }}
                </div>
            {% endif %}
        </div>

        <!-- Description -->
        <div>
            {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 dark:text-white mb-2'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-900 placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-vertical', 'rows': '4', 'style': 'color: #000 !important;'}}) }}
            {% if form.description.vars.errors %}
                <div class="mt-1 text-sm text-red-600 dark:text-red-400">
                    {{ form_errors(form.description) }}
                </div>
            {% endif %}
        </div>

        <!-- Grille 2 colonnes: Prix et Plateforme -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Prix -->
            <div>
                {{ form_label(form.prix, 'Prix', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 dark:text-white mb-2'}}) }}
                {{ form_widget(form.prix, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-900 placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition', 'step': '0.01', 'style': 'color: #000 !important;'}}) }}
                {% if form.prix.vars.errors %}
                    <div class="mt-1 text-sm text-red-600 dark:text-red-400">
                        {{ form_errors(form.prix) }}
                    </div>
                {% endif %}
            </div>

            <!-- Plateforme -->
            <div>
                {{ form_label(form.plateforme, 'Plateforme', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 dark:text-white mb-2'}}) }}
                {{ form_widget(form.plateforme, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition', 'style': 'color: #000 !important;'}}) }}
                {% if form.plateforme.vars.errors %}
                    <div class="mt-1 text-sm text-red-600 dark:text-red-400">
                        {{ form_errors(form.plateforme) }}
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Grille 2 colonnes: PEGI et État -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- PEGI -->
            <div>
                {{ form_label(form.pegi, 'PEGI', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 dark:text-white mb-2'}}) }}
                {{ form_widget(form.pegi, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition', 'style': 'color: #000 !important;'}}) }}
                {% if form.pegi.vars.errors %}
                    <div class="mt-1 text-sm text-red-600 dark:text-red-400">
                        {{ form_errors(form.pegi) }}
                    </div>
                {% endif %}
            </div>

            <!-- État -->
            <div>
                {{ form_label(form.etat, 'État', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 dark:text-white mb-2'}}) }}
                {{ form_widget(form.etat, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition', 'style': 'color: #000 !important;'}}) }}
                {% if form.etat.vars.errors %}
                    <div class="mt-1 text-sm text-red-600 dark:text-red-400">
                        {{ form_errors(form.etat) }}
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Statut -->
        <div>
            {{ form_label(form.statut, 'Statut', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 dark:text-white mb-2'}}) }}
            {{ form_widget(form.statut, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-900 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition', 'style': 'color: #000 !important;'}}) }}
            {% if form.statut.vars.errors %}
                <div class="mt-1 text-sm text-red-600 dark:text-red-400">
                    {{ form_errors(form.statut) }}
                </div>
            {% endif %}
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 flex items-start gap-2">
                <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <span>Le statut "Vendu" se met à jour automatiquement lors d'une vente</span>
            </p>
        </div>

        <!-- Image URL -->
        <div>
            {{ form_label(form.image, 'Image (URL)', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 dark:text-white mb-2'}}) }}
            {{ form_widget(form.image, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-gray-900 placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition', 'placeholder': 'https://exemple.com/image.jpg', 'style': 'color: #000 !important;'}}) }}
            {% if form.image.vars.errors %}
                <div class="mt-1 text-sm text-red-600 dark:text-red-400">
                    {{ form_errors(form.image) }}
                </div>
            {% endif %}
            
            <!-- Aperçu de l'image actuelle -->
            {% if jeu.image %}
                <div class="mt-4">
                    <p class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Aperçu actuel :</p>
                    <img src="{{ jeu.image }}" alt="Aperçu du jeu" class="max-w-xs h-auto rounded-lg border border-gray-300 dark:border-slate-700 shadow">
                </div>
            {% endif %}
        </div>

        <!-- Boutons d'action -->
        <div class="flex gap-3 pt-6 border-t border-gray-200 dark:border-slate-700">
            <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-6 rounded-lg transition flex items-center justify-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Enregistrer les modifications
            </button>
            <a href="{{ path('app_ventes', {'vendeurId': jeu.vendeur.id}) }}" class="flex-1 bg-gray-200 dark:bg-slate-800 hover:bg-gray-300 dark:hover:bg-slate-700 text-gray-900 dark:text-white font-medium py-3 px-6 rounded-lg transition text-center">
                Annuler
            </a>
        </div>

        {{ form_end(form) }}
    </div>

</div>
{% endblock %}