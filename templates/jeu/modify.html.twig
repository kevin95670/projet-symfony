{% extends "base.html.twig" %}

{% block title %}Modifier - {{ jeu.titre }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- En-tête avec bouton retour -->
    <div class="mb-8">
        <a href="{{ path('app_ventes', {'vendeurId': jeu.vendeur.id}) }}" class="text-[#b9b0cc] hover:text-[#f5a623] mb-4 inline-flex items-center gap-1 text-sm transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Retour
        </a>
        <h1 class="text-3xl font-bold text-white">Modifier le jeu</h1>
        <p class="mt-2 text-[#b9b0cc]">{{ jeu.titre }}</p>
    </div>

    <!-- Formulaire -->
    <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-6 sm:p-8">
        {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

        <!-- Titre -->
        <div>
            {{ form_label(form.titre, 'Titre', {'label_attr': {'class': 'block text-sm font-medium text-[#b9b0cc] mb-2'}}) }}
            {{ form_widget(form.titre, {'attr': {'class': 'w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white placeholder-[#5d5573] focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition'}}) }}
            {% if form.titre.vars.errors %}
                <div class="mt-1 text-sm text-[#ff8a80]">
                    {{ form_errors(form.titre) }}
                </div>
            {% endif %}
        </div>

        <!-- Description -->
        <div>
            {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-[#b9b0cc] mb-2'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white placeholder-[#5d5573] focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition resize-y', 'rows': '4'}}) }}
            {% if form.description.vars.errors %}
                <div class="mt-1 text-sm text-[#ff8a80]">
                    {{ form_errors(form.description) }}
                </div>
            {% endif %}
        </div>

        <!-- Grille 2 colonnes: Prix et Plateforme -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Prix -->
            <div>
                {{ form_label(form.prix, 'Prix', {'label_attr': {'class': 'block text-sm font-medium text-[#b9b0cc] mb-2'}}) }}
                {{ form_widget(form.prix, {'attr': {'class': 'w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white placeholder-[#5d5573] focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition', 'step': '0.01'}}) }}
                {% if form.prix.vars.errors %}
                    <div class="mt-1 text-sm text-[#ff8a80]">
                        {{ form_errors(form.prix) }}
                    </div>
                {% endif %}
            </div>

            <!-- Plateforme -->
            <div>
                {{ form_label(form.plateforme, 'Plateforme', {'label_attr': {'class': 'block text-sm font-medium text-[#b9b0cc] mb-2'}}) }}
                {{ form_widget(form.plateforme, {'attr': {'class': 'w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition'}}) }}
                {% if form.plateforme.vars.errors %}
                    <div class="mt-1 text-sm text-[#ff8a80]">
                        {{ form_errors(form.plateforme) }}
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Grille 2 colonnes: PEGI et État -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- PEGI -->
            <div>
                {{ form_label(form.pegi, 'PEGI', {'label_attr': {'class': 'block text-sm font-medium text-[#b9b0cc] mb-2'}}) }}
                {{ form_widget(form.pegi, {'attr': {'class': 'w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition'}}) }}
                {% if form.pegi.vars.errors %}
                    <div class="mt-1 text-sm text-[#ff8a80]">
                        {{ form_errors(form.pegi) }}
                    </div>
                {% endif %}
            </div>

            <!-- État -->
            <div>
                {{ form_label(form.etat, 'État', {'label_attr': {'class': 'block text-sm font-medium text-[#b9b0cc] mb-2'}}) }}
                {{ form_widget(form.etat, {'attr': {'class': 'w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition'}}) }}
                {% if form.etat.vars.errors %}
                    <div class="mt-1 text-sm text-[#ff8a80]">
                        {{ form_errors(form.etat) }}
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Statut -->
        <div>
            {{ form_label(form.statut, 'Statut', {'label_attr': {'class': 'block text-sm font-medium text-[#b9b0cc] mb-2'}}) }}
            {{ form_widget(form.statut, {'attr': {'class': 'w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition'}}) }}
            {% if form.statut.vars.errors %}
                <div class="mt-1 text-sm text-[#ff8a80]">
                    {{ form_errors(form.statut) }}
                </div>
            {% endif %}
            <p class="mt-2 text-sm text-[#8a82a0] flex items-start gap-2">
                <svg class="w-4 h-4 flex-shrink-0 mt-0.5 text-[#f5a623]" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <span>Le statut "Vendu" se met à jour automatiquement lors d'une vente</span>
            </p>
        </div>

        <!-- Image URL -->
        <div>
            {{ form_label(form.image, 'Image (URL)', {'label_attr': {'class': 'block text-sm font-medium text-[#b9b0cc] mb-2'}}) }}
            {{ form_widget(form.image, {'attr': {'class': 'w-full px-4 py-2.5 bg-[#110d1b] border border-[#2e2640] rounded-md text-white placeholder-[#5d5573] focus:outline-none focus:border-[#f5a623] focus:ring-1 focus:ring-[#f5a623] transition', 'placeholder': 'https://exemple.com/image.jpg'}}) }}
            {% if form.image.vars.errors %}
                <div class="mt-1 text-sm text-[#ff8a80]">
                    {{ form_errors(form.image) }}
                </div>
            {% endif %}

            <!-- Aperçu de l'image actuelle -->
            {% if jeu.image %}
                <div class="mt-4">
                    <p class="text-sm font-medium text-[#b9b0cc] mb-3">Aperçu actuel :</p>
                    <img src="{{ jeu.image }}" alt="Aperçu du jeu" class="max-w-xs h-auto rounded-md border border-[#2e2640]">
                </div>
            {% endif %}
        </div>

        <!-- Boutons d'action -->
        <div class="flex gap-3 pt-6 border-t border-[#2e2640]">
            <button type="submit" class="flex-1 bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-3 px-6 rounded-md transition flex items-center justify-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Enregistrer les modifications
            </button>
            <a href="{{ path('app_ventes', {'vendeurId': jeu.vendeur.id}) }}" class="flex-1 border border-[#2e2640] hover:border-[#f5a623] text-[#b9b0cc] hover:text-white font-medium text-sm py-3 px-6 rounded-md transition text-center">
                Annuler
            </a>
        </div>

        {{ form_end(form) }}
    </div>

</div>
{% endblock %}
