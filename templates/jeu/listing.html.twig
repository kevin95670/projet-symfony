{% extends 'base.html.twig' %}

{% block title %}
    {% if query %}Résultats pour "{{ query }}"{% else %}Liste des jeux{% endif %}
{% endblock %}

{% block body %}
    <div class="max-w-6xl mx-auto px-4 py-8">

        {# Filtres #}
        <form method="GET" action="{{ path('app_jeux_liste') }}" class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-5 mb-8">
            {# On garde le terme de recherche si présent, pour qu'il ne se perde pas quand on filtre #}
            {% if query %}
                <input type="hidden" name="query" value="{{ query }}">
            {% endif %}

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-end">

                <div>
                    <label class="block text-xs text-[#8a82a0] mb-1">Catégorie</label>
                    <select name="categorie" class="w-full bg-[#110d1b] border border-[#2e2640] text-sm text-white rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]">
                        <option value="">Toutes</option>
                        {% for cat in categories %}
                            <option value="{{ cat.slug }}" {{ app.request.query.get('categorie') == cat.slug ? 'selected' : '' }}>
                                {{ cat.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label class="block text-xs text-[#8a82a0] mb-1">Prix min (€)</label>
                    <input type="number" name="prix_min" min="0" step="1"
                           value="{{ app.request.query.get('prix_min') }}"
                           class="w-full bg-[#110d1b] border border-[#2e2640] text-sm text-white rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]">
                </div>

                <div>
                    <label class="block text-xs text-[#8a82a0] mb-1">Prix max (€)</label>
                    <input type="number" name="prix_max" min="0" step="1"
                           value="{{ app.request.query.get('prix_max') }}"
                           class="w-full bg-[#110d1b] border border-[#2e2640] text-sm text-white rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]">
                </div>

                <div>
                    <label class="block text-xs text-[#8a82a0] mb-1">PEGI</label>
                    <select name="pegi" class="w-full bg-[#110d1b] border border-[#2e2640] text-sm text-white rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]">
                        <option value="">Tous</option>
                        {% for pegi in pegis %}
                            <option value="{{ pegi.value }}" {{ app.request.query.get('pegi') == pegi.value ? 'selected' : '' }}>
                                PEGI {{ pegi.value }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="flex gap-2">
                    <button type="submit" class="flex-1 bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-2 px-4 rounded-md transition">
                        Filtrer
                    </button>
                    <a href="{{ path('app_jeux_liste') }}" class="flex items-center justify-center border border-[#2e2640] hover:border-[#f5a623] text-[#b9b0cc] hover:text-white text-sm py-2 px-4 rounded-md transition">
                        Réinitialiser
                    </a>
                </div>

            </div>
        </form>

        {# Titre résultats #}
        {% if query %}
            <h1 class="text-2xl font-bold text-white mb-6">Résultats pour "{{ query }}"</h1>
        {% else %}
            <h1 class="text-2xl font-bold text-white mb-6">Liste des jeux</h1>
        {% endif %}

        {# Grille de jeux #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for jeu in jeux %}
                <article class="group bg-[#1c1628] border border-[#2e2640] rounded-lg overflow-hidden hover:border-[#f5a623]/60 transition">

                    <div class="aspect-4/3 bg-[#2a2040] overflow-hidden">
                        {% if jeu.image %}
                            <img src="{{ jeu.image }}" alt="{{ jeu.titre }}" loading="lazy"
                                 class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                        {% else %}
                            <div class="w-full h-full flex items-center justify-center text-[#5d5573] text-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                                </svg>
                            </div>
                        {% endif %}
                    </div>

                    <div class="p-5">
                        <div class="flex items-start justify-between gap-3 mb-2">
                            <h3 class="font-semibold text-white leading-snug">{{ jeu.titre }}</h3>
                            <span class="shrink-0 text-lg font-bold text-[#f5a623]">{{ jeu.prix }} €</span>
                        </div>

                        <p class="text-sm text-[#b9b0cc] line-clamp-2 mb-4">{{ jeu.description }}</p>

                        <div class="flex flex-wrap gap-2 mb-4">
                            {% if jeu.categories %}
                                {% for categorie in jeu.categories %}
                                    <a href="{{ path('app_jeux_par_categorie', {'slug': categorie.slug}) }}"
                                    class="px-2 py-0.5 text-xs rounded-sm bg-[#f5a623]/15 text-[#f5a623] border border-[#f5a623]/40 hover:bg-[#f5a623]/25 transition font-medium">
                                        {{ categorie.nom }}
                                    </a>
                                {% endfor %}
                            {% endif %}
                            <span class="px-2 py-0.5 text-xs rounded-sm bg-[#110d1b] border border-[#2e2640] text-[#b9b0cc]">{{ jeu.plateforme.value }}</span>
                            <span class="px-2 py-0.5 text-xs rounded-sm bg-[#110d1b] border border-[#2e2640] text-[#b9b0cc]">{{ jeu.etat.value }}</span>
                            {% if jeu.pegi %}
                                <span class="px-2 py-0.5 text-xs rounded-sm bg-[#110d1b] border border-[#2e2640] text-[#b9b0cc]">PEGI {{ jeu.pegi.value }}</span>
                            {% endif %}
                        </div>

                        <div class="flex items-center justify-between pt-4 border-t border-[#2e2640]">
                            <a href="{{ path('vue_vendeur', {'pseudo': jeu.vendeur.pseudo}) }}"
                            class="inline-flex items-center gap-1.5 text-sm text-[#b9b0cc] hover:text-[#f5a623] transition underline decoration-[#2e2640] hover:decoration-[#f5a623] underline-offset-2">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                </svg>
                                {{ jeu.vendeur.pseudo }}
                            </a>
                            <a href="{{ path('app_jeu', {'slug': jeu.slug, 'id': jeu.id}) }}" class="text-sm font-medium text-[#f5a623] hover:text-white transition">Voir →</a>
                        </div>
                    </div>

                </article>
            {% else %}
                <p class="col-span-full text-[#8a82a0]">Aucun jeu ne correspond à ces critères.</p>
            {% endfor %}
        </div>

        {# Pagination : affichée seulement s'il y a plus d'une page #}
        {% include 'components/pagination.html.twig' with {'page': page, 'pages': pages} only %}

    </div>
{% endblock %}
