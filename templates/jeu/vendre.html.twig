{% extends 'base.html.twig' %}

{% block title %}Vendre un jeu{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-4 py-12">

        <div class="mb-8">
            <h1 class="text-2xl font-bold text-white mb-2">Vendre un jeu</h1>
            <p class="text-[#b9b0cc]">
                Remplis les informations ci-dessous pour mettre ton jeu en vente. Sois précis sur son état
                et sa description pour rassurer les acheteurs — plus une annonce est complète, plus elle se vend vite.
            </p>
        </div>

        {% for flash in app.flashes('success') %}
            <div class="bg-[#9ae6b4]/10 border border-[#9ae6b4]/30 text-[#9ae6b4] text-sm rounded-md px-4 py-3 mb-6">
                {{ flash }}
            </div>
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'bg-[#1c1628] border border-[#2e2640] rounded-lg p-6 space-y-5'}}) }}

            <div>
                {{ form_label(form.titre, 'Titre du jeu', {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-1'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'w-full bg-[#110d1b] border border-[#2e2640] text-white text-sm rounded-md px-3 py-2 placeholder-[#5d5573] focus:outline-none focus:border-[#f5a623]'}}) }}
                {{ form_errors(form.titre) }}
            </div>

            <div>
                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-1'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full bg-[#110d1b] border border-[#2e2640] text-white text-sm rounded-md px-3 py-2 placeholder-[#5d5573] focus:outline-none focus:border-[#f5a623]', 'rows': 4}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    {{ form_label(form.prix, 'Prix', {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-1'}}) }}
                    {{ form_widget(form.prix, {'attr': {'class': 'w-full bg-[#110d1b] border border-[#2e2640] text-white text-sm rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]'}}) }}
                    {{ form_errors(form.prix) }}
                </div>

                <div>
                    {{ form_label(form.plateforme, 'Plateforme', {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-1'}}) }}
                    {{ form_widget(form.plateforme, {'attr': {'class': 'w-full bg-[#110d1b] border border-[#2e2640] text-white text-sm rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]'}}) }}
                    {{ form_errors(form.plateforme) }}
                </div>

                <div>
                    {{ form_label(form.etat, 'État', {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-1'}}) }}
                    {{ form_widget(form.etat, {'attr': {'class': 'w-full bg-[#110d1b] border border-[#2e2640] text-white text-sm rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]'}}) }}
                    {{ form_errors(form.etat) }}
                </div>

                <div>
                    {{ form_label(form.pegi, 'PEGI', {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-1'}}) }}
                    {{ form_widget(form.pegi, {'attr': {'class': 'w-full bg-[#110d1b] border border-[#2e2640] text-white text-sm rounded-md px-3 py-2 focus:outline-none focus:border-[#f5a623]'}}) }}
                    {{ form_errors(form.pegi) }}
                </div>
            </div>

            <div>
                {{ form_label(form.categories, null, {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-2'}}) }}
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                    {% for category in form.categories %}
                        <label class="flex items-center gap-2 bg-[#110d1b] border border-[#2e2640] rounded-md px-3 py-2 text-sm text-[#b9b0cc] cursor-pointer hover:border-[#f5a623] transition">
                            {{ form_widget(category, {'attr': {'class': 'accent-[#f5a623]'}}) }}
                            {{ category.vars.label }}
                        </label>
                    {% endfor %}
                </div>
                {{ form_errors(form.categories) }}
            </div>

            <div>
                {{ form_label(form.imageFichier, null, {'label_attr': {'class': 'block text-sm text-[#b9b0cc] mb-1'}}) }}
                {{ form_widget(form.imageFichier, {'attr': {'class': 'w-full text-sm text-[#b9b0cc] file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:bg-[#2a2040] file:text-white hover:file:bg-[#f5a623] hover:file:text-[#111] file:transition'}}) }}
                <p class="text-xs text-[#5d5573] mt-1">JPG, PNG ou WebP, 2 Mo maximum.</p>
                {{ form_errors(form.imageFichier) }}
            </div>

            <button type="submit" class="w-full bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-3 px-6 rounded-md transition">
                Mettre en vente
            </button>

        {{ form_end(form) }}

    </div>
{% endblock %}
