{% extends 'base.html.twig' %}

{% block title %}Vendre un jeu{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-4 py-12">

        <div class="mb-8">
            <h1 class="text-2xl font-bold text-white mb-2">Vendre un jeu</h1>
            <p class="text-slate-400">
                Remplis les informations ci-dessous pour mettre ton jeu en vente. Sois précis sur son état
                et sa description pour rassurer les acheteurs — plus une annonce est complète, plus elle se vend vite.
            </p>
        </div>

        {% for flash in app.flashes('success') %}
            <div class="bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-sm rounded-lg px-4 py-3 mb-6">
                {{ flash }}
            </div>
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'bg-slate-900 border border-slate-800 rounded-xl p-6 space-y-5'}}) }}

            <div>
                {{ form_label(form.titre, 'Titre du jeu', {'label_attr': {'class': 'block text-sm text-slate-300 mb-1'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'w-full bg-slate-800 border border-slate-700 text-white text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-cyan-500'}}) }}
                {{ form_errors(form.titre) }}
            </div>

            <div>
                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm text-slate-300 mb-1'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full bg-slate-800 border border-slate-700 text-white text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-cyan-500', 'rows': 4}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    {{ form_label(form.prix, 'Prix', {'label_attr': {'class': 'block text-sm text-slate-300 mb-1'}}) }}
                    {{ form_widget(form.prix, {'attr': {'class': 'w-full bg-slate-800 border border-slate-700 text-white text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-cyan-500'}}) }}
                    {{ form_errors(form.prix) }}
                </div>

                <div>
                    {{ form_label(form.plateforme, 'Plateforme', {'label_attr': {'class': 'block text-sm text-slate-300 mb-1'}}) }}
                    {{ form_widget(form.plateforme, {'attr': {'class': 'w-full bg-slate-800 border border-slate-700 text-white text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-cyan-500'}}) }}
                    {{ form_errors(form.plateforme) }}
                </div>

                <div>
                    {{ form_label(form.etat, 'État', {'label_attr': {'class': 'block text-sm text-slate-300 mb-1'}}) }}
                    {{ form_widget(form.etat, {'attr': {'class': 'w-full bg-slate-800 border border-slate-700 text-white text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-cyan-500'}}) }}
                    {{ form_errors(form.etat) }}
                </div>

                <div>
                    {{ form_label(form.pegi, 'PEGI', {'label_attr': {'class': 'block text-sm text-slate-300 mb-1'}}) }}
                    {{ form_widget(form.pegi, {'attr': {'class': 'w-full bg-slate-800 border border-slate-700 text-white text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-cyan-500'}}) }}
                    {{ form_errors(form.pegi) }}
                </div>
            </div>

            <div>
                {{ form_label(form.categories, null, {'label_attr': {'class': 'block text-sm text-slate-300 mb-2'}}) }}
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                    {% for category in form.categories %}
                        <label class="flex items-center gap-2 bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-300 cursor-pointer hover:border-cyan-500 transition">
                            {{ form_widget(category, {'attr': {'class': 'accent-cyan-500'}}) }}
                            {{ category.vars.label }}
                        </label>
                    {% endfor %}
                </div>
                {{ form_errors(form.categories) }}
            </div>

            <div>
                {{ form_label(form.image, null, {'label_attr': {'class': 'block text-sm text-slate-300 mb-1'}}) }}
                {{ form_widget(form.image, {'attr': {'class': 'w-full bg-slate-800 border border-slate-700 text-white text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-cyan-500', 'placeholder': 'https://...'}}) }}
                {{ form_errors(form.image) }}
            </div>

            <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 px-6 rounded-lg transition">
                Mettre en vente
            </button>

        {{ form_end(form) }}

    </div>
{% endblock %}