{% extends 'base.html.twig' %}

{% block title %}Ma liste de souhaits{% endblock %}

{% block body %}
    <div class="max-w-6xl mx-auto px-4 py-10">

        <h1 class="text-2xl font-bold text-white mb-6">Ma liste de souhaits</h1>

        {% for flash in app.flashes('success') %}
            <div class="bg-[#9ae6b4]/10 border border-[#9ae6b4]/30 text-[#9ae6b4] text-sm rounded-md px-4 py-3 mb-6">
                {{ flash }}
            </div>
        {% endfor %}

        {% if wishlistItems|length > 0 %}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for item in wishlistItems %}
                    {% set jeu = item.jeu %}
                    {% set isAvailable = jeu.statut.name == 'EN_VENTE' %}
                    {% set isOwnJeu = app.user and jeu.vendeur.id == app.user.id %}
                    {% set isModified = jeu.getMiseAJour() and item.getDateAjout() and jeu.getMiseAJour() > item.getDateAjout() %}

                    <article class="group bg-[#1c1628] border border-[#2e2640] rounded-lg overflow-hidden hover:border-[#f5a623]/60 transition {% if not isAvailable %}opacity-75{% endif %}">

                        <div class="relative aspect-4/3 bg-[#2a2040] overflow-hidden">
                            {% if jeu.image %}
                                <img src="{{ jeu.image }}" alt="{{ jeu.titre }}"
                                     class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                            {% else %}
                                <div class="w-full h-full flex items-center justify-center text-[#5d5573] text-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                                    </svg>
                                </div>
                            {% endif %}

                            <!-- Badge "Votre annonce" -->
                            {% if isOwnJeu %}
                                <div class="absolute top-3 left-3 bg-[#f5a623] text-[#111] rounded-sm px-2.5 py-1 flex items-center gap-1.5">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5.951-1.488 5.951 1.488a1 1 0 001.169-1.409l-7-14z" />
                                    </svg>
                                    <span class="text-xs font-bold">Votre annonce</span>
                                </div>
                            {% endif %}

                            <!-- Badge statut si non disponible -->
                            {% if not isAvailable %}
                                <div class="absolute inset-0 bg-[#0d0a14]/70 flex items-center justify-center">
                                    <div class="text-center">
                                        <p class="text-white font-bold text-lg">
                                            {% if jeu.statut.name == 'VENDU' %}
                                                Vendu
                                            {% else %}
                                                Retiré de la vente
                                            {% endif %}
                                        </p>
                                    </div>
                                </div>
                            {% endif %}

                            {# Bouton retirer de la wishlist #}
                            <form action="{{ path('app_jeu_wishlist_toggle', {'id': jeu.id}) }}" method="post" class="absolute top-3 right-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle-wishlist-' ~ jeu.id) }}">
                                <button type="submit"
                                        title="Retirer de la wishlist"
                                        class="bg-[#110d1b]/80 hover:bg-[#ff8a80] hover:text-[#111] text-white rounded-full p-2 transition">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </form>
                        </div>

                        <div class="p-5">
                            <!-- Alerte si modifié -->
                            {% if isModified %}
                                <div class="bg-[#f5a623]/10 border border-[#f5a623]/40 text-[#f5a623] rounded-md px-4 py-3 flex items-start gap-3 mb-4">
                                    <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                    </svg>
                                    <div class="flex-1">
                                        <p class="font-medium text-sm">Ce jeu a été modifié depuis son ajout à la wishlist</p>
                                        <p class="text-xs mt-1 text-[#b9b0cc]">Vérifie que les informations te conviennent toujours</p>
                                    </div>
                                </div>
                            {% endif %}

                            <div class="flex items-start justify-between gap-3 mb-2">
                                <h3 class="font-semibold text-white leading-snug">{{ jeu.titre }}</h3>
                                <span class="shrink-0 text-lg font-bold text-[#f5a623]">{{ jeu.prix }} €</span>
                            </div>

                            <p class="text-sm text-[#b9b0cc] line-clamp-2 mb-4">{{ jeu.description }}</p>

                            <div class="flex flex-wrap gap-2 mb-4">
                                {% for categorie in jeu.categories %}
                                    <a href="{{ path('app_jeux_par_categorie', {'slug': categorie.slug}) }}"
                                       class="px-2 py-0.5 text-xs rounded-sm bg-[#f5a623]/15 text-[#f5a623] border border-[#f5a623]/40 hover:bg-[#f5a623]/25 transition font-medium">
                                        {{ categorie.nom }}
                                    </a>
                                {% endfor %}
                                <span class="px-2 py-0.5 text-xs rounded-sm bg-[#110d1b] border border-[#2e2640] text-[#b9b0cc]">{{ jeu.plateforme.label }}</span>
                                <span class="px-2 py-0.5 text-xs rounded-sm bg-[#110d1b] border border-[#2e2640] text-[#b9b0cc]">{{ jeu.etat.label }}</span>
                            </div>

                            <div class="flex items-center justify-between pt-4 border-t border-[#2e2640] mb-3">
                                <a href="{{ path('vue_vendeur', {'pseudo': jeu.vendeur.pseudo}) }}"
                                   class="inline-flex items-center gap-1.5 text-sm text-[#b9b0cc] hover:text-[#f5a623] transition underline decoration-[#2e2640] hover:decoration-[#f5a623] underline-offset-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                    </svg>
                                    {{ jeu.vendeur.pseudo }}
                                </a>
                                <a href="{{ path('app_jeu', {'slug': jeu.slug, 'id': jeu.id}) }}" class="text-sm font-medium text-[#f5a623] hover:text-white transition">Voir →</a>
                            </div>

                            <!-- Bouton Ajouter au panier ou État non disponible ou Votre annonce -->
                            {% if isOwnJeu %}
                                {# C'est son propre jeu #}
                                <button disabled class="flex items-center justify-center w-full bg-[#2e2640] text-[#8a82a0] font-bold text-sm py-3 px-6 rounded-md cursor-not-allowed">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    C'est votre annonce
                                </button>
                            {% elseif isAvailable %}
                                {# Disponible et pas son jeu #}
                                <a href="#" class="flex items-center justify-center w-full bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-3 px-6 rounded-md transition">
                                    Ajouter au panier
                                </a>
                            {% else %}
                                {# Pas disponible #}
                                <button disabled class="flex items-center justify-center w-full bg-[#2e2640] text-[#8a82a0] font-bold text-sm py-3 px-6 rounded-md cursor-not-allowed">
                                    {% if jeu.statut.name == 'VENDU' %}
                                        Produit vendu
                                    {% else %}
                                        Produit retiré
                                    {% endif %}
                                </button>
                            {% endif %}
                        </div>

                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-[#1c1628] border border-[#2e2640] rounded-lg p-12 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 mx-auto text-[#f5a623] mb-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                </svg>
                <p class="text-[#b9b0cc] mb-4">Ta liste de souhaits est vide pour le moment.</p>
                <a href="{{ path('app_jeux_liste') }}" class="inline-block bg-white hover:bg-[#f5a623] text-[#111] font-bold text-sm py-2.5 px-6 rounded-md transition">
                    Parcourir les jeux
                </a>
            </div>
        {% endif %}

    </div>
{% endblock %}
