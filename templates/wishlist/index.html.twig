{% extends 'base.html.twig' %}

{% block title %}Ma liste de souhaits{% endblock %}

{% block body %}
    <div class="max-w-6xl mx-auto px-4 py-8">

        <h1 class="text-2xl font-bold text-white mb-6">Ma liste de souhaits</h1>

        {% for flash in app.flashes('success') %}
            <div class="bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-sm rounded-lg px-4 py-3 mb-6">
                {{ flash }}
            </div>
        {% endfor %}

        {% if wishlistItems|length > 0 %}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for item in wishlistItems %}
                    {% set jeu = item.jeu %}
                    <article class="group bg-slate-900 border border-slate-800 rounded-xl overflow-hidden hover:border-slate-700 transition">

                        <div class="relative aspect-4/3 bg-slate-800 overflow-hidden">
                            {% if jeu.image %}
                                <img src="{{ jeu.image }}" alt="{{ jeu.titre }}"
                                     class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                            {% else %}
                                <div class="w-full h-full flex items-center justify-center text-slate-600 text-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                                    </svg>
                                </div>
                            {% endif %}

                            {# Bouton retirer de la wishlist #}
                            <form action="{{ path('app_jeu_wishlist_toggle', {'id': jeu.id}) }}" method="post" class="absolute top-3 right-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle-wishlist-' ~ jeu.id) }}">
                                <button type="submit"
                                        title="Retirer de la wishlist"
                                        class="bg-slate-950/80 hover:bg-red-500/90 text-white rounded-full p-2 transition">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </form>
                        </div>

                        <div class="p-5">
                            <div class="flex items-start justify-between gap-3 mb-2">
                                <h3 class="font-semibold text-white leading-snug">{{ jeu.titre }}</h3>
                                <span class="shrink-0 text-lg font-bold text-white">{{ jeu.prix }} €</span>
                            </div>

                            <p class="text-sm text-slate-400 line-clamp-2 mb-4">{{ jeu.description }}</p>

                            <div class="flex flex-wrap gap-2 mb-4">
                                {% for categorie in jeu.categories %}
                                    <a href="{{ path('app_jeux_par_categorie', {'slug': categorie.slug}) }}"
                                       class="px-2 py-0.5 text-xs rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 hover:bg-cyan-500/30 hover:text-cyan-200 transition font-medium">
                                        {{ categorie.nom }}
                                    </a>
                                {% endfor %}
                                <span class="px-2 py-0.5 text-xs rounded bg-slate-800 text-slate-300">{{ jeu.plateforme.label }}</span>
                                <span class="px-2 py-0.5 text-xs rounded bg-slate-800 text-slate-300">{{ jeu.etat.label }}</span>
                            </div>

                            <div class="flex items-center justify-between pt-4 border-t border-slate-800 mb-3">
                                <a href="{{ path('vue_vendeur', {'pseudo': jeu.vendeur.pseudo}) }}"
                                   class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-cyan-300 transition underline decoration-slate-700 hover:decoration-cyan-400 underline-offset-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                    </svg>
                                    {{ jeu.vendeur.pseudo }}
                                </a>
                                <a href="{{ path('app_jeu', {'slug': jeu.slug, 'id': jeu.id}) }}" class="text-sm font-medium text-cyan-400 hover:text-cyan-300 transition">Voir →</a>
                            </div>

                            <a href="#" class="flex items-center justify-center w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-3 px-6 rounded-lg transition">
                                Ajouter au panier
                            </a>
                        </div>

                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-slate-900 border border-slate-800 rounded-xl p-12 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 mx-auto text-slate-600 mb-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                </svg>
                <p class="text-slate-400 mb-4">Ta liste de souhaits est vide pour le moment.</p>
                <a href="{{ path('app_jeux_liste') }}" class="inline-block bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-2 px-6 rounded-lg transition">
                    Parcourir les jeux
                </a>
            </div>
        {% endif %}

    </div>
{% endblock %}